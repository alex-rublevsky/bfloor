---
import Head from "@/components/shared/Head.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Вход в панель управления" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <Head title={title} description={description} />
  </head>

  <body>
    <slot />
  </body>
</html>
