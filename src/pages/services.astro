          диагонали)</td
        >
        <td>1050</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td
          >Укладка паркета / инженерной доски / пробки плавающим способом
          (ёлочкой)</td
        >
        <td>1500</td>
        <td>р/м²</td>
      </tr>
    </table>

    <table>
      <caption>Укладка клеевых покрытий</caption>
      <tr>
        <th>Услуга</th>
        <th>Стоимость</th>
        <th>Ед. измерения</th>
      </tr>
      <tr>
        <td>Укладка ПВХ</td>
        <td>750</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка резиновых покрытий</td>
        <td>850</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка пробки</td>
        <td>1500</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка ковровой плитки</td>
        <td>750</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка линолеума</td>
        <td>600</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка линолеума с заводами на стены</td>
        <td>900</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td
          >Укладка антистатического и токопроводящего линолеума на токоотводящую
          систему</td
        >
        <td>850</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка мармолеума</td>
        <td>1000</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка паркета / инженерной доски</td>
        <td>2000</td>
        <td>р/м²</td>
      </tr>
    </table>

    <table>
      <th>Укладка плитки пвх (кварц винил)</th>
    </table>

    <table>
      <th>Укладка пробки</th>
    </table>

    <table>
      <th>Укладка паркета / инженерной доски</th>
    </table>

    <table>
      <th>Укладка линолеума</th>
    </table>

    <table>
      <th>Укладка ковролина / ковровой плитки</th>
    </table>

    <table>
      <th>Монтаж плинтуса</th>
    </table>

    <table>
      <th>Подготовка основания</th>
    </table>

    <table>
      <th>Дополнительные работы</th>
    </table>
