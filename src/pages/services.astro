---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
export const prerender = true;
import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Input from "@/components/shared/Input.astro";
---

<!-- TODO: дописать описание -->
<Layout title=`Укладка и иные услуги — ${SITE_TITLE}` description="">
  <section>
    <h1>Укладка</h1>
    <p>Укладываем все покрытия из нашего ассортимента</p>
    <p>Гарантия 1 год</p>
    <h3>Что включает услуга укладки напольного покрытия?</h3>
    <ul style="list-style-type:disc;">
      <li>бесплатный выезд замерщика для определения точных объемов работ</li>
      <li>
        подготовка основания, а при необходимости — демонтаж существующего пола
      </li>
      <li>
        комплектование объекта всеми необходимыми материалами, включая расходные
      </li>
      <li>непосредственная укладка напольного покрытия</li>
      <li>
        при необходимости — дополнительная обработка декоративной поверхности
      </li>
      <li>Мы не оставляем после себя никакого мусора</li>
    </ul>
    <p class="text-foreground-muted">
      Описанная схема оказания услуги является типовой. При необходимости она
      корректируется с учетом технологических особенностей и характеристики
      конкретного напольного покрытия.
    </p>
    <!--
    - наименование
    - стоимость работ за единицу
    - единица измерения
    - вписывать сколько тебе надо
    - всего
   	стоимость работ	ед.изм

https://petro-pol.ru/montazh/
    -->

    <table>
      <caption>Демонтаж</caption>
      <tr>
        <th>Услуга</th>
        <th>Стоимость</th>
        <th>Ед. измерения</th>
      </tr>
      <tr>
        <td>Демонтаж приклеенных покрытий</td>
        <td><span class="text-foreground-muted">от </span>200</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Демонтаж свободно лежащих покрытий <u>без сохранения</u></td>
        <td><span class="text-foreground-muted">от </span>150</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Демонтаж свободно лежащих покрытий <u>с сохранением</u></td>
        <td><span class="text-foreground-muted">от </span>300</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Демонтаж плинтуса <u>без сохранения</u></td>
        <td><span class="text-foreground-muted">от </span>75</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Демонтаж плинтуса <u>с сохранением</u></td>
        <td><span class="text-foreground-muted">от </span>150</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Разбор/демонтаж основания</td>
        <td colspan="2">по договорённости</td>
      </tr>
    </table>
    <table>
      <caption>Подготовка основания</caption>

      <tr>
        <th>Услуга</th>
        <th>Стоимость</th>
        <th>Ед. измерения</th>
      </tr>
      <tr>
        <td>Выравнивание основания финишным ровнителем</td>
        <td>550</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Обеспыливание и покрытие грунтом</td>
        <td>200</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Отчистка основания от клея</td>
        <td>500</td>
        <td>р/м²</td>
      </tr>
    </table>

    <table>
      <caption>Укладка замковых покрытий</caption>
      <tr>
        <th>Услуга</th>
        <th>Стоимость</th>
        <th>Ед. измерения</th>
      </tr>
      <tr>
        <td>Укладка ламината/ПВХ <u>по прямой (палуба)</u></td>
        <td>650</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка ламината/ПВХ <u>по диагонали</u></td>
        <td>750</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td>Укладка ламината/ПВХ <u>ёлочкой</u></td>
        <td><span class="text-foreground-muted">от </span>1300</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td
          >Укладка паркета / инженерной доски / пробки плавающим способом (по
          прямой)</td
        >
        <td>850</td>
        <td>р/м²</td>
      </tr>
      <tr>
        <td
