---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
export const prerender = true;
import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Input from "@/components/shared/Input.astro";
---

<!-- TODO: дописать описание -->
<Layout title=`Укладка и иные услуги — ${SITE_TITLE}` description="">
  <main>
    <section>
      <h1>Укладка</h1>

      <h3>Что включает услуга укладки напольного покрытия?</h3>
      <p>Мы укладываем все покрытия из нашего ассортимента</p>
      <ul style="list-style-type:disc;">
        <li>
          <b>Бесплатный выезд и замеры</b> при покупке материалов или заказе работ
        </li>

        <li>
          Комплектовация объекта всеми необходимыми материалами, включая
          расходные
        </li>

        <li>Мы не оставляем после себя никакого мусора</li>

        <li>Гарантия 1 год</li>
      </ul>

      <!--
https://petro-pol.ru/montazh/
    -->

      <table>
        <caption>Демонтаж</caption>
        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>
        <tr>
          <td>Демонтаж приклеенных покрытий</td>
          <td><span class="text-foreground-muted">от </span>200 / м²</td>
        </tr>
        <tr>
          <td>Демонтаж свободно лежащих покрытий <u>без сохранения</u></td>
          <td><span class="text-foreground-muted">от </span>150 / м²</td>
        </tr>
        <tr>
          <td>Демонтаж свободно лежащих покрытий <u>с сохранением</u></td>
          <td><span class="text-foreground-muted">от </span>300 / м²</td>
        </tr>
        <tr>
          <td>Демонтаж плинтуса <u>без сохранения</u></td>
          <td><span class="text-foreground-muted">от </span>75 / м²</td>
        </tr>
        <tr>
          <td>Демонтаж плинтуса <u>с сохранением</u></td>
          <td><span class="text-foreground-muted">от </span>150 / м²</td>
        </tr>
        <tr>
          <td>Разбор/демонтаж основания</td>
          <td colspan="2">по договорённости</td>
        </tr>
      </table>
      <table>
        <caption>Подготовка основания</caption>

        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>
        <tr>
          <td>Выравнивание основания финишным ровнителем</td>
          <td>550 / м²</td>
        </tr>
        <tr>
          <td>Обеспыливание и покрытие грунтом</td>
          <td>200 / м²</td>
        </tr>
        <tr>
          <td>Отчистка основания от клея</td>
          <td>500 / м²</td>
        </tr>
      </table>

      <table>
        <caption>Укладка замковых покрытий</caption>
        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>
        <tr>
          <td>Укладка <b>ламината</b> / <b>ПВХ</b> <u>по прямой (палуба)</u></td
          >
          <td>650 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>ламината</b> / <b>ПВХ</b> <u>по диагонали</u></td>
          <td>750 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>ламината</b> / <b>ПВХ</b> <u>ёлочкой</u></td>
          <td><span class="text-foreground-muted">от </span>1 300 / м²</td>
        </tr>
        <tr>
          <td
            >Укладка <b>паркета</b> / <b>инженерной доски</b> / <b>пробки</b> плавающим
            способом <u>по прямой</u></td
          >
          <td>850 / м²</td>
        </tr>
        <tr>
          <td
            >Укладка <b>паркета</b> / <b>инженерной доски</b> / <b>пробки </b>
            плавающим способом <u>по диагонали</u></td
          >
          <td>1 050 / м²</td>
        </tr>
        <tr>
          <td
            >Укладка <b>паркета</b> / <b>инженерной доски</b> / <b>пробки</b> плавающим
            способом <u>ёлочкой</u></td
          >
          <td>1 500 / м²</td>
        </tr>
      </table>

      <table>
        <caption>Укладка клеевых покрытий</caption>
        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>
        <tr>
          <td>Укладка <b>ПВХ</b></td>
          <td>750 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>резиновых покрытий</b></td>
          <td>850 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>пробки</b></td>
          <td>1 500 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>ковровой плитки</b></td>
          <td>750 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>линолеума</b></td>
          <td>600 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>линолеума</b> с заводом на стены</td>
          <td>900 / м²</td>
        </tr>
        <tr>
          <td
            >Укладка антистатического и токопроводящего <b>линолеума</b> на токоотводящую
            систему</td
          >
          <td>850 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>мармолеума</b></td>
          <td>1 000 / м²</td>
        </tr>
        <tr>
          <td>Укладка <b>паркета</b> / <b>инженерной доски</b></td>
          <td>2 300 / м²</td>
        </tr>
        <tr>
          <td>Покрытие <b>пробки</b> лаком</td>
          <td>150 / слой</td>
        </tr>
      </table>

      <table>
        <caption>Монтаж плинтуса</caption>
        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>
        <tr>
          <td>Монтаж пластикового плинтуса с фурнитурой</td>
          <td>250 / погонный метр</td>
        </tr>
        <tr>
          <td>Монтаж плинтуса под запил</td>
          <td>450 / погонный метр</td>
        </tr>
        <tr>
          <td>Монтаж коннелюрного плинтуса</td>
          <td>400 / погонный метр</td>
        </tr>
        <tr>
          <td>Монтаж металлического плинтуса</td>
          <td>550 / погонный метр</td>
        </tr>
        <tr>
          <td>Установка порога 0.9м</td>
          <td>600 / штука</td>
        </tr>
      </table>
      <table>
        <caption>Дополнительные работы</caption>
        <tr>
          <th>Услуга</th>
          <th class="whitespace-nowrap">Стоимость р</th>
        </tr>

        <tr>
          <td>Выезд и замеры</td>
          <td>2 000 / выезд</td>
        </tr>
        <tr>
          <td>Подъём материалов на этаж</td>
          <td colspan="2">по договорённости</td>
        </tr>
        <tr>
          <td>Вынос мусора</td>
          <td colspan="2">по договорённости</td>
        </tr>
      </table>
      <p class="text-foreground-muted py-xl">
        Описанная схема оказания услуг является типовой. При необходимости она
        корректируется с учетом технологических особенностей и характеристики
        конкретного напольного покрытия.
      </p>
      <section id="cta">
        <Image
          src={BASE_IMAGE_URL + "other/ukladka.jpg"}
          height={1000}
          width={1333}
          alt="Фото процесса укладки"
          class="skeleton"
          onload="this.closest('.skeleton')?.classList.remove('skeleton')"
        />
        <div>
          <h2>Позвоните нам или оставьте заявку</h2>
          <p class="max-w-[60ch]">
            Наши специалисты проконсультирует вас, осуществят <a
              href="/delivery">доставку</a
            > по Приморскому краю и уложат любое покрытие из нашего ассортимента
          </p>
          <p class="text-md pt-sm">
            Позвонить: <a class="text-md" href="tel:+79025559405"
              >8 902 555 9405</a
            ><span class="text-foreground-muted italic"> Роман</span>
          </p>
        </div>
      </section>

      <table>
        <caption>Требования к основанию</caption>
        <tr>
          <th>Прочность</th>
          <td
            >Прочность цементно-песчаной стяжки на сжатие не менее 150 кг/см²
            (15 МПа)</td
          >
          <td>СНиП 2.03.13-88, п. 5.3</td>
        </tr>
        <tr>
          <th>Влажность</th>
          <td>Железобетонные панели не более 4%</td>
          <td>Полы. Технические требования…, п. 8.17.4</td>
        </tr>
        <tr>
          <th>Стабильность</th>
          <td
            >Просадка основания не должна превышать 1,5мм под нагрузкой 200кг</td
          >
          <td>ВСН 9-94</td>
        </tr>
        <tr>
          <th>Ровность</th>
          <td>Отклонение от плоскости не более 2мм относительно рейки 2м</td>
          <td>СНиП 3.04.01-87, п. 4.24</td>
        </tr>
      </table>

      <!--
    <div>
      <Input name="name" label="Имя" />
      <Input name="phone" label="Телефон" type="number" />
      <Checkbox
        >Я даю согласие на обработку своих персональных данных
      </Checkbox>
    </div> -->
    </section>
  </main>
</Layout>

<style>
  li {
    margin-left: var(--spacing-lg);
    padding-block: var(--spacing-2xs);
  }

  table {
    margin-top: var(--spacing-sm);
    border-collapse: collapse;
    width: min(fit-content, 100%);
  }

  caption {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  caption,
  th {
    text-align: left;
  }

  td,
  th,
  caption {
    padding: var(--spacing-2xs);
  }

  th {
    background-color: color-mix(in oklch, var(--primary) 18%, transparent);
  }

  td {
    line-height: 1.4;
    text-underline-offset: 2px;
  }

  tr:nth-of-type(2n) {
    background-color: color-mix(in oklch, var(--secondary) 12%, transparent);
  }

  @media (width < 768px) {
    th,
    td,
    span {
      line-height: 1.25;
      font-size: var(--text-sm);
    }
  }

  #cta {
    padding-bottom: var(--spacing-3xl);
    display: grid;
    gap: var(--spacing-sm);

    & div {
      justify-content: start;
      align-content: center;
    }

    & img {
      border-radius: var(--radius-sm);
      max-height: 50vh;
      width: auto;
      justify-self: end;
    }

    @media (width >= 768px) {
      grid-template-columns: auto auto;
    }
  }
</style>
