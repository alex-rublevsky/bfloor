---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Button from "@/components/shared/Button.astro";
import Link from "@/components/shared/Link.astro";
import { auth } from "@/lib/auth";
import { Icon } from "astro-icon/components";

const error = Astro.url.searchParams.get("error");

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const user = session?.user ?? null;
const displayName = user?.name || user?.email;
const displayPic = user?.image;
---

<AuthLayout title="Вход в админку">
  <main class="w-full max-w-120 space-y-6 text-center grid">
    <>
      {
        displayName ? (
          <h1 class="text-md! font-thin! text-foreground-muted leading-[1.7] mb-0">
            Вы уже авторизованы,
            <br />
            <span class="inline-flex items-center justify-center gap-2">
              {displayPic && (
                <img
                  src={displayPic}
                  alt="Profile picture"
                  referrerpolicy="no-referrer"
                  class="size-12 rounded-full object-cover"
                />
              )}
              <span class="text-2xl">{displayName}</span>
            </span>
          </h1>
        ) : (
          <h1 class="text-xl! font-thin! text-foreground-muted">
            Вход в админку
          </h1>
        )
      }
    </>
    <div class="grid grid-cols-2 gap-2xs">
      {
        displayName ? (
          <Button size="lg" href="/dashboard">
            В админку
          </Button>
        ) : (
          //TODO: fix icon not being in a row
          <Button id="google-signin" class="w-full">
            <Icon name="google" title="Google" />
            <span data-signin-label>Войти</span>
          </Button>
        )
      }
      <Button size="lg" variant="tertiary" href="/"> &larr; В магазин </Button>
    </div>
    {
      error === "unauthorized" && (
        <div class="bg-destructive border-destructive-foreground/50! text-destructive-foreground rounded-md border px-4 py-3">
          У вас нет доступа
        </div>
      )
    }
  </main>
</AuthLayout>

<script>
  document
    .getElementById("google-signin")
    ?.addEventListener("click", async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const label = button.querySelector<HTMLSpanElement>(
        "[data-signin-label]",
      );
      button.disabled = true;
      if (label) label.textContent = "Вход...";

      try {
        const response = await fetch("/api/auth/sign-in/social", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            provider: "google",
            callbackURL: "/dashboard",
          }),
        });

        if (!response.ok) {
          alert("Не удалось войти. Попробуйте еще раз.");
          button.disabled = false;
          if (label) label.textContent = "Войти";
          return;
        }

        const data = await response.json();

        if (data.url) {
          window.location.href = data.url;
        } else {
          alert("Ошибка аутентификации: Нет redirect URL");
          button.disabled = false;
          if (label) label.textContent = "Войти";
        }
      } catch (_error) {
        alert("Ошибка сети. Попробуйте еще раз.");
        button.disabled = false;
        if (label) label.textContent = "Войти";
      }
    });
</script>
