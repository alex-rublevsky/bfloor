---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Button from "@/components/shared/Button.astro";
import { auth } from "@/lib/auth";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";

const error = Astro.url.searchParams.get("error");

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const user = session?.user ?? null;
const displayName = user?.name || user?.email;
const displayPic = user?.image;
---

<AuthLayout title="Вход в админку">
  <main class="grid place-items-center">
    <div class="blockWrapper">
      <Image
        src={BASE_IMAGE_URL + "other/bubisha.jpeg"}
        width={1000}
        height={1000}
        alt="Заяц Маскот"
        loading="eager"
        class="skeleton bubisha"
        onload="this.closest('.skeleton')?.classList.remove('skeleton')"
      />

      {
        displayName ? (
          <h1 class="text-md! font-thin! text-center text-foreground-muted leading-[1.7] mb-0">
            Вы уже авторизованы,
            <br />
            <span class="inline-flex items-center justify-center gap-2">
              {displayPic && (
                <img
                  src={displayPic}
                  alt="Profile picture"
                  referrerpolicy="no-referrer"
                  class="size-12 rounded-full object-cover"
                />
              )}
              <span class="text-xl">{displayName}</span>
            </span>
          </h1>
        ) : (
          <h1 class="text-xl! font-thin! text-foreground-muted">
            Вход в админку
          </h1>
        )
      }

      <div class="grid grid-cols-2 gap-2xs">
        {
          displayName ? (
            <Button size="lg" href="/dashboard">
              В админку
            </Button>
          ) : (
            //TODO: fix icon not being in a row
            <Button size="lg" id="google-signin">
              <Icon name="google" title="Google" />
              <span data-signin-label>Войти</span>
            </Button>
          )
        }
        <Button size="lg" variant="tertiary" href="/"> &larr; Назад </Button>
      </div>
      {
        error === "unauthorized" && (
          <div class="bg-destructive border-destructive-foreground/50! text-destructive-foreground rounded-md border px-4 py-3">
            У вас нет доступа
          </div>
        )
      }
    </div>
  </main>
</AuthLayout>

<style>
  .blockWrapper {
    display: grid;
    justify-items: center;
    @media (width < 768px) {
      translate: 0 -1.4rem;
    }
  }
  .bubisha {
    border-radius: var(--radius-md);
    width: min(80vw, 23rem);
  }
</style>

<script>
  document
    .getElementById("google-signin")
    ?.addEventListener("click", async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const label = button.querySelector<HTMLSpanElement>(
        "[data-signin-label]",
      );
      button.disabled = true;
      if (label) label.textContent = "Вход...";

      try {
        const response = await fetch("/api/auth/sign-in/social", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            provider: "google",
            callbackURL: "/dashboard",
          }),
        });

        if (!response.ok) {
          alert("Не удалось войти. Попробуйте еще раз.");
          button.disabled = false;
          if (label) label.textContent = "Войти";
          return;
        }

        const data = await response.json();

        if (data.url) {
          window.location.href = data.url;
        } else {
          alert("Ошибка аутентификации: Нет redirect URL");
          button.disabled = false;
          if (label) label.textContent = "Войти";
        }
      } catch (_error) {
        alert("Ошибка сети. Попробуйте еще раз.");
        button.disabled = false;
        if (label) label.textContent = "Войти";
      }
    });
</script>
