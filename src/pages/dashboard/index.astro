---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ProductFeed from "@/components/dashboard/ProductFeed.astro";
import ProductFiltering from "@/components/dashboard/ProductFiltering.astro";

const categoryId = Number(Astro.url.searchParams.get("categoryId")) || 1;
---

<DashboardLayout>
  <main class="pt-xl">
    <ProductFiltering categoryId={categoryId} />
    <ProductFeed categoryId={categoryId} />
  </main>
</DashboardLayout>

<script>
  import { clearFormDrafts, PRODUCT_FORM_DRAFT_PREFIX } from "@/lib/formDrafts";

  clearFormDrafts(PRODUCT_FORM_DRAFT_PREFIX);
</script>
