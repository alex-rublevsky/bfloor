---
import Layout from "@/layouts/DashboardLayout.astro";
import ProductForm from "@/components/dashboard/ProductForm.astro";
import { getDashboardReturnTo } from "@/lib/dashboardReturnTo";
import { actions } from "astro:actions";

const creationResult = Astro.getActionResult(actions.product.createProduct);
if (creationResult && !creationResult.error) {
  return Astro.redirect(getDashboardReturnTo(Astro.url));
}
---

<Layout>
  <main><ProductForm /></main>
</Layout>
