---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getProductBySlug } from "@/db/dashboard/products/productBySlug";
import type { ProductWithStoreLocations } from "@/db/dashboard/products/index";
import ProductForm from "@/components/dashboard/ProductForm.astro";
import { actions } from "astro:actions";

const updateResult = Astro.getActionResult(actions.product.updateProduct);
if (updateResult && !updateResult.error) {
  return Astro.redirect(`/dashboard`);
}

const { slug } = Astro.params;

const product: ProductWithStoreLocations | null = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect("/dashboard/product/404");
}
---

<DashboardLayout title={product.name}>
  <main>
    <ProductForm product={product} />
  </main>
</DashboardLayout>
