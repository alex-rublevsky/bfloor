---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import AttributeForm from "@/components/dashboard/AttributeForm.astro";
import { type Attribute, getAttributeBySlug } from "@/db/dashboard/attributes";

const { slug } = Astro.params;

const attribute: Attribute | null = await getAttributeBySlug(slug);

if (!attribute) {
  return Astro.redirect("/dashboard/attributes/404");
}
---

<DashboardLayout title={attribute.name}>
  <main>
    <AttributeForm attribute={attribute} />
  </main>
</DashboardLayout>
