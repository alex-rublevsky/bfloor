---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import {
  type Collection,
  getCollectionBySlug,
} from "@/db/dashboard/collections/";
import CollectionForm from "@/components/dashboard/CollectionForm.astro";

const { slug } = Astro.params;

const collection: Collection | null = await getCollectionBySlug(slug);

if (!collection) {
  return Astro.redirect("/dashboard/collections/404");
}
---

<DashboardLayout title={collection.name}>
  <main>
    <CollectionForm collection={collection} />
  </main>
</DashboardLayout>
