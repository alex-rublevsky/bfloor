---
import Gallery from "@/components/Gallery.astro";
import ProductInfo from "@/components/ProductInfo.astro";
import type { StorefrontProduct } from "@/db/storefront/products/types";
import { getProductsForSlugPages } from "@/db/storefront/products/allProductsForSlug";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getProductsForSlugPages();
  return products.map((product) => {
    return {
      params: { slug: product.slug },
      props: { product },
      //TODO: remove the "?"
      cacheKey: product.updatedAt?.toString(),
    };
  });
};

interface Props {
  product: StorefrontProduct;
}
const { product } = Astro.props;
---

<Layout title={product.name}>
  <section
    class="no-padding relative flex flex-col items-start gap-sm md:flex-row lg:gap-md">
    <Gallery
      class="w-full self-start lg:sticky lg:top-0"
      images={product.images}
      slug={product.slug}
      alt={product.name}
    />
    <ProductInfo product={product} />
  </section>
</Layout>
