---
import Gallery from "@/components/Gallery.astro";
import ProductInfo from "@/components/ProductInfo.astro";
import type { StorefrontProductDetails } from "@/db/storefront/products/types";
import { getProductsForSlugPages } from "@/db/storefront/products/allProductsForSlug";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/constants";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getProductsForSlugPages();
  return products.map((product) => {
    return {
      params: { slug: product.slug },
      props: { product },
      //TODO: remove the "?"
      cacheKey: product.updatedAt?.toString(),
    };
  });
};

interface Props {
  product: StorefrontProductDetails;
}
const { product } = Astro.props;

// TODO: fix this to be reliable, e.g. lack of brand should not result in double space
const title =
  product.category.name +
  " " +
  product.brand?.name +
  " " +
  product.name +
  " - " +
  SITE_TITLE;

// TODO: include attributes — декор под дерево, класс износостойкости 33, толщина 12 мм. Подходит для тёплого пола; фаска с четырёх сторон.
// if there is not description, make it via name + attribues + SITE_DESCRIPTION
const description = product.description ?? SITE_DESCRIPTION;
---

<Layout title={title} description={description}>
  <section data-pagefind-body class="no-padding mainSection">
    <Gallery images={product.images} />
    <ProductInfo product={product} />
  </section>
  <section class="pb-3xl">
    <h2>Поможем с укладкой</h2>
    <p>
      Наши специалисты проконсультирует вас, осуществят доставку по Приморскому
      краю и уложат любое покрытие из нашего ассортимента
    </p>
    <p class="text-md pt-sm">
      Позвонить Роману: <a class="text-md" href="tel:+79025559405"
        >8 902 555 9405</a
      >
    </p>
  </section>
</Layout>

<style>
  .mainSection {
    position: relative;
    display: grid;
    container-type: inline-size;
    grid-template-rows: 1fr auto;
    @media (width > 35rem) {
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    @media (width > 75rem) {
      grid-template-columns: 6fr 4fr;
    }
  }
  /*TODO: proportionally decrease sizes of all headings...?*/
  h2 {
    font-size: var(--text-xl);
  }
</style>
