---
import Layout from "@/layouts/Layout.astro";
import { getProductsForSlugPages } from "@/db/storefront/allProductsForSlug";
import type { GetStaticPaths } from "astro";
import { BASE_IMAGE_URL } from "@/constants";
import Gallery from "@/components/Gallery.astro";
import type { StorefrontProduct } from "@/db/storefront/allProductsForSlug";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
    const products = await getProductsForSlugPages();
    return products.map((p) => ({
        params: { slug: p.slug },
        props: {
            id: p.id,
            name: p.name,
            images: p.images,
            description: p.description,
            // variations: p.variations,
            // category: p.category,
        },
    }));
};

type Props = Pick<
    StorefrontProduct,
    "id" | "name" | "images" | "description" | "category"
> & {
    variations: {
        id: number;
        // weight: number;
        price: number;
        discountPrice?: number | null;
    }[];
};

const { id, name, images, description, variations, category } =
    Astro.props as Props;
const slug = Astro.params.slug as string;
const productImage = images[0] ? BASE_IMAGE_URL + images[0] : null;
const serializedProduct = JSON.stringify({
    id,
    name,
    slug,
    image: productImage,
});
---

<Layout title={name}>
    <div class="grid grid-cols-2 gap-sm">
        <Gallery
            class:list="w-full self-start lg:sticky lg:top-0 lg:w-3/5 xl:w-2/3"
            images={images}
            slug={slug}
            alt={name}
        />

        <div>
            <h1>
                {name}
            </h1>
            <!-- <a href={`/store/${categorySlug}`}>
                {categoryName}
            </a> -->
            <!-- {
                brandSlug ? (
                    <a href={`/brand/${brandSlug}`}>
                        {brandName}
                    </a>
                ) : null
            } -->

            <!-- {
                collectionSlug ? (
                    <a href={`/collection/${collectionSlug}`}>
                        {collectionName}
                    </a>
                ) : null
            } -->

            <!-- {
                discountedPrice ? (
                    <>
                        <p class="line-through">{price}</p>{" "}
                        <p>{discountedPrice}</p>
                    </>
                ) : (
                    <p>{price}</p>
                )
            } -->
        </div>
    </div>
</Layout>
