---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/shared/Button.astro";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Icon } from "astro-icon/components";
import { SITE_TITLE } from "@/constants";

export const prerender = true;
---

<!-- TODO: нужна ли запятая? -->
<Layout
  title=`Контакты и адреса — ${SITE_TITLE}`
  description=`Мы находимся на ул. Русская 78 и в ТЦ "Виктория" пав. №14. Вы можете связаться с нами по телефону, почте или мессенджерам.`>
  <section>
    <h1 class="sr-only">Контакты и адреса</h1>
    <div class="h-90 md:h-full">
      <iframe
        id="map_949370315"
        frameborder="0"
        width="100%"
        height="100%"
        src="https://makemap.2gis.ru/widget?data=eJytk12TojgUhv8Lc6k1HQQRrOoLDN0QRQTaWQu25kKBiUEES6JCd_V_3xPErd2tuZnd5eaEnK83OU8-pOqcZucstbPqmPEzy2pp-vuHxNtTJk2l12zLL-dMGkqnc3XKzrzzf0hJVVRn8H_RZLRFMvg544XIQJEfXFqVooUVUsOeocgJLhzfUKTXxEpUCE2zOjmzE2dVCQm-Yw7Q3A33KR4gN6Ai4cogObUxcich9cS-ErLWCrhYR1Zw5fgduVSPSjLAecN8jkvkdjku8WwT1kEt6kVuyN4r3R2RgW_PWz-_XRNLXfhOuI-OTeHTihKrQUmu6qkdgI6n4PpmMToHHfOnkOaQq4QHP29QjGfvqVPU8RqxxH49xHZxiVu5jjcxWjGz8cqZSthsv7OLcpdDzLEot07A_PzlRlYLs8Bms7JuV9HHx4bouSDY1FMHtDnQg-M9cl804YutTg9NlHC8s78ZpJztYzs87Y4J39m_HVOrost1fMswodGmOcUjFWLmYPeI5Gqz7M-wXCe9fugLfTAzKfRqu_NYk-DA7dkq7zXdNbyh6NrPYh1cO3v4e40u_pWBrgEM852UadZIUxk9vs-hRO8wtQKVniS_YiWH-KQC4Fi55R1osiJ_NUa6rKlDVfkqa7qORt-hAEulqSFK_RcSF25wYiYDuIKLhzWAAcARcORh3pKaePipA4WpVK3eNst18PxzOh9Iz52-wESQqAoqaQqFgby8NZHHdHlpNUxM1rfJAC1-BLUnnkBNBbW1h5uOaG674tYjoE4QDBO_AYn641b_OaXSwMadIAvWNv7rxIjjoWwDJL_Nb9EmPGw349KF_7gMNGK9jBKHMmK_1ttNeoGYFmyVYjJY_UkI_SVC_m2_5foFLhl_gxjlQTj0bcW5wfav8fn5_yFKGaPJuCcKafKDKFlGo8_vQ-m4PflVze4j_pCKLZemfbCOxkCjYijGUCqE-15P1uTJaGwYE4AVFFbVETwalAVWqqLY7LOsiLtdfr5kn38AZ_Wv8w"
        sandbox="allow-modals allow-forms allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"
      ></iframe>
    </div>
    <div class="md:pt-sm">
      <div>
        <h2 class="text-lg leading-none">Контакты</h2>

        <div class="card">
          {
            STORE_LOCATIONS.map((location) => (
              <div class="contact">
                <a
                  class="text-link"
                  href={`tel:${location.phone.replace(/\D/g, "").replace(/^8/, "+7")}`}>
                  {location.phone}
                </a>
                <span class="name">{location.address}</span>
              </div>
            ))
          }
          <div class="contact">
            <a class="text-link" href="tel:+79084466740">8 908 446 6740</a>
            <span class="name">Елена</span>
          </div>
          <div class="contact">
            <a class="text-link" href="tel:+79025559405">8 902 555 9405</a><span
              class="name">Роман</span
            >
          </div>

          <a class="text-link" href="mailto:romavg@mail.ru">romavg@mail.ru</a>
        </div>
      </div>
      <div>
        <h2 class="text-lg leading-none">Адреса</h2>

        {
          STORE_LOCATIONS.map((location) => (
            <div class="card" data-location-id={location.id}>
              <div>
                <p>{location.address}</p>
                {location.description && (
                  <span class="text-sm leading-none">
                    {location.description}
                  </span>
                )}
              </div>

              <div>
                <p class="label">Часы работы:</p>
                {location.openingHours.split("\n").map((hours) => (
                  <p>{hours}</p>
                ))}
              </div>
              <Button
                href={`https://yandex.ru/maps/?text=${encodeURIComponent(`Владивосток, ${location.address}`)}`}
                class="mt-2xs">
                Построить маршрут{" "}
                <Icon
                  class="size-7 -translate-y-0.5"
                  name="yandexMaps"
                  title="Яндекс Карты"
                />
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  section {
    display: grid;
    direction: column-reverse;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-lg);
  }
  @media (width < 768px) {
    section {
      grid-template-columns: 1fr;
    }
  }
  .name {
    font-style: italic;
    font-weight: medium;
    color: var(--color-muted-foreground);
  }
  .card {
    display: grid;
    background-color: var(--muted);
    padding: var(--spacing-xs);
    white-space: nowrap;
    margin-bottom: var(--spacing-sm);
  }
  .contact {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
  }
  .label {
    font-weight: bold;
  }
</style>
