---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/shared/Button.astro";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Icon } from "astro-icon/components";

export const prerender = true;
---

<Layout>
  <h1 class="sr-only">Contacts and Addresses</h1>

  <section>
    <div class="h-90 md:h-full">
      <iframe
        src="https://yandex.ru/map-widget/v1/?um=constructor%3A22b0e239472f3fada224e5a5d56d660e01904d9ce2b2758272c86ee79efaa7ca&source=constructor"
        width="100%"
        height="100%"
        frameborder="0"
        class="skeleton"
        onload="this.closest('.skeleton')?.classList.remove('skeleton')"
      ></iframe>
    </div>
    <div class="md:pt-sm">
      <div>
        <h2 class="text-lg leading-none">Контакты</h2>

        <div class="card">
          {
            STORE_LOCATIONS.map((location) => (
              <div class="contact">
                <a
                  class="text-link"
                  href={`tel:${location.phone.replace(/\D/g, "")}`}>
                  {location.phone}
                </a>
                <span class="name">{location.address}</span>
              </div>
            ))
          }

          <div class="contact">
            <a class="text-link" href="tel:+89025559405">8 902 555 9405</a><span
              class="name">Роман</span
            >
          </div>
          <div class="contact">
            <a class="text-link" href="tel:+89084466740">8 908 446 6740</a>
            <span class="name">Елена</span>
          </div>
          <a class="text-link" href="mailto:romavg@mail.ru">romavg@mail.ru</a>
        </div>
      </div>
      <div>
        <h2 class="text-lg leading-none">Адреса</h2>

        {
          STORE_LOCATIONS.map((location) => (
            <div class="card" data-location-id={location.id}>
              <div>
                <p>{location.address}</p>
                {location.description && (
                  <span class="text-sm leading-none">
                    {location.description}
                  </span>
                )}
              </div>

              <div>
                <p class="label">Часы работы:</p>
                {location.openingHours.split("\n").map((hours) => (
                  <p>{hours}</p>
                ))}
              </div>
              <Button
                href={`https://yandex.ru/maps/?text=${encodeURIComponent(`Владивосток, ${location.address}`)}`}
                class="mt-2xs">
                Построить маршрут{" "}
                <Icon
                  class="size-7 -translate-y-0.5"
                  name="yandexMaps"
                  title="Яндекс Карты"
                />
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  section {
    display: grid;
    direction: column-reverse;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-lg);
  }
  @media (max-width: 768px) {
    section {
      grid-template-columns: 1fr;
    }
  }
  .name {
    font-style: italic;
    font-weight: medium;
    color: var(--color-muted-foreground);
  }
  .card {
    display: grid;
    background-color: var(--muted);
    padding: var(--spacing-xs);
    white-space: nowrap;
    margin-bottom: var(--spacing-sm);
  }
  .contact {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
  }
  .label {
    font-weight: bold;
  }
</style>
