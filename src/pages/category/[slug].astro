---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/shared/ProductCard.astro";

import { getProductsByCategory } from "@/db/storefront/allProducts";
import type { GetStaticPaths } from "astro";
import { getAllCategories } from "@/db/storefront/allCategories";
// import type { Product } from "@/db/storefront/allProducts";
import type { Category } from "@/db/storefront/allCategories";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
    const categories = await getAllCategories();
    return categories.map((category) => ({
        params: { slug: category.slug },
        props: { category: category },
    }));
};

type Props = {
    category: Category;
};

const { category } = Astro.props as Props;

const products = await getProductsByCategory(category.slug);
---

<Layout title={category.name}>
    <h1>
        {category.name}
    </h1>
    <div>
        {products.map((product) => <ProductCard product={product} />)}
    </div>
</Layout>
