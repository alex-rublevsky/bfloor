---
import type { Page } from "astro";
import ProductCard from "@/components/shared/ProductCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllProductsByCategory } from "@/db/storefront/products/allProductsByCategory";
import type { Category } from "@/db/schema";
import Pagination from "@/components/shared/Pagination.astro";
import { getAllCategories } from "@/db/storefront/allCategories";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import ErrorNotice from "@/components/shared/ErrorNotice.astro";

export const prerender = true;

type Props = {
  page: Page<any>;
  category: Category;
};
const { slug } = Astro.params;

if (!slug) return Astro.redirect("/catalog");

export async function getStaticPaths({ paginate }: any) {
  const categories = await getAllCategories();

  const results = [];
  for (const category of categories) {
    const products = (await getAllProductsByCategory(category.id)) ?? [];

    results.push(
      paginate(products, {
        params: {
          slug: category.slug,
        },
        props: {
          category,
        },
        pageSize: 50,
      }),
    );
  }

  return results.flat();
}

const categoryBaseUrl = `/catalog/${slug}`;

const { page, category } = Astro.props;

const locationLabels = Object.fromEntries(
  STORE_LOCATIONS.map(({ id, address }) => [String(id), address]),
);
---

<!--
TODO: is it possible to make the filters persistent between /catalog/ pages?
currently they flash

TODO: add results and filtered results counts

TODO: add loading state to the filters before they show up

TODO: add filters to mobile

TODO: add counts to filter blocks, e.g. 12 brands

TODO: disable scroll while viewing filters on mobile

TODO: add bottom padding to the mobile filters screen, make sure it is scrollable
 -->
<Layout title={category.name}>
  <main>
    <section
      class="no-padding"
      data-category={category.name}
      data-location-labels={JSON.stringify(locationLabels)}>
      <div class="titlePagination">
        <h1 class="text-xl pb-0">{category.name}</h1>
        <Pagination
          data-pagination
          length={page.lastPage}
          currentPage={page.currentPage}
          firstUrl={page.url.first}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          lastUrl={page.url.last}
          baseUrl={categoryBaseUrl}
        />
        <!-- {category.description ? <p>{category.description}</p> : null} -->
      </div>

      <div class="storeLayout">
        <Button
          variant="tertiary"
          id="mobileFiltersButton"
          aria-controls="catalogFilters"
          aria-expanded="false">Фильтры</Button
        >

        <aside id="catalogFilters">
          <h3>Фильтры</h3>

          <div id="filtersLoading" role="status" aria-live="polite">
            <span class="sr-only">Загружаем фильтры</span>

            {
              Array.from({ length: 5 }, () => (
                <div class="filterSkeletonWrapper">
                  <div class="skeleton filterSkeletonTitle" />
                  <div class="filterSkeleton skeleton" aria-hidden="true">
                    {Array.from({ length: 5 }, () => (
                      <div class="skeleton filterSkeletonOption" />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <ErrorNotice
            id="catalogFilteringError"
            message="Не удалось загрузить фильтры. Показаны все товары категории."
            hidden
          />

          <div id="filtersBlock" hidden></div>

          <template id="filter-block-template">
            <fieldset class="filter">
              <legend></legend>
              <div class="filter-options"></div>
            </fieldset>
          </template>
          <!-- checkboxes are used instead of multiple select listbox for user experince:
        for a listbox to select multiple options command needs to be pressed which
        is not obvious -->
          <template id="filter-option-template">
            <Checkbox><span class="filter-option-label"></span></Checkbox>
          </template>
        </aside>
        <!-- TODO: when there is only one row of products on desktop, their heights are full screen. fix -->
        <div id="staticFeed" class="autoGrid">
          <!-- {
          products ? (
            products.length > 0 ? (
              products.map((product: any) => <ProductCard product={product} />)
            ) : (
              <p>Товаров не найдено</p>
            )
          ) : (
            <p>Товаров не найдено</p>
          )
        } -->
          {
            ((page as any).data || []).map((product: any) => (
              <ProductCard product={product} />
            ))
          }
        </div>
        <div id="filteredFeed" class="autoGrid" hidden></div>
        <template id="catalog-loading-skeleton">
          <div class="catalogProductSkeleton" aria-hidden="true">
            <div class="entityImageWrapper">
              <div class="entityImage skeleton"></div>
            </div>
            <div class="catalogSkeletonText">
              <div class="skeleton catalogSkeletonLine"></div>
              <div
                class="skeleton catalogSkeletonLine catalogSkeletonLineShort">
              </div>
            </div>
          </div>
        </template>
        <template id="catalogProductErrorTemplate">
          <ErrorNotice
            message="Не удалось загрузить товары по выбранным фильтрам. Попробуйте ещё раз."
          />
        </template>
        <template id="product-card-template">
          <a>
            <div class="entityImageWrapper">
              <div class="entityImage"></div>
            </div>

            <div class="productPrices">
              <span data-card-from class="fromLabel" hidden>от</span>
              <span data-card-sale-price class="price"></span>
              <span data-card-sale-unit class="currencyAndUnit"></span>
              <span data-card-price></span>
              <span data-card-unit class="currencyAndUnit"></span>
            </div>

            <p class="productName text-sm" data-card-name></p>
          </a>
        </template>
        <template id="image-placeholder">
          <div class="w-full aspect-square grid place-items-center skeleton">
            <Icon
              name="image"
              title="Сломанная картинка"
              class="size-14 text-muted-foreground"
            />
          </div>
        </template>
      </div>
      <Pagination
        data-pagination
        class="pt-lg pb-xl justify-center w-full"
        length={page.lastPage}
        currentPage={page.currentPage}
        firstUrl={page.url.first}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        lastUrl={page.url.last}
        baseUrl={categoryBaseUrl}
      />
    </section>
  </main>
</Layout>

<style>
  @media (width > 768px) {
    section {
      padding-right: var(--section-padding-x);
    }
  }

  @media (width < 768px) {
    #catalogFilters h3 {
      padding-inline: var(--section-padding-x);
      padding-top: var(--section-padding-x);
      padding-bottom: var(--spacing-sm);
    }
  }

  .storeLayout {
    display: grid;
    grid-template-columns: min-content 1fr;
    @media (width < 768px) {
      grid-template-columns: auto;
    }
  }

  .titlePagination {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-2xs) var(--spacing-md);
    padding-block: var(--spacing-xs) var(--spacing-md);
    padding-inline: var(--section-padding-x);
  }

  #mobileFiltersButton {
    position: fixed;
    inset: auto var(--spacing-3xs) 3.5rem auto;
    z-index: 100;
    @media (width >= 768px) {
      display: none;
    }
    @media (width >= 500px) {
      inset: auto var(--spacing-3xs) var(--spacing-3xs) auto;
    }
  }

  #filtersBlock {
    display: grid;
    gap: var(--spacing-md);

    @media (width >= 768px) {
      gap: var(--spacing-sm);
    }
  }

  #filtersLoading {
    display: grid;
    gap: var(--spacing-2xs);

    @media (width < 768px) {
      gap: var(--spacing-md);
    }
  }

  .filterSkeletonWrapper {
    display: grid;
    gap: var(--spacing-3xs);
  }

  .filterSkeleton {
    display: grid;
    gap: var(--spacing-3xs);
    padding: var(--spacing-2xs);
    width: 100%;
    border-radius: var(--radius-md);

    @media (width < 768px) {
      display: flex;
    }
  }

  .filterSkeletonTitle {
    width: 55%;
    height: 1.25rem;
    border-radius: var(--radius-sm);
    margin-inline: var(--spacing-2xs);

    @media (width < 768px) {
      width: 35%;
      width: 35%;
    }
  }

  .filterSkeletonOption {
    width: 100%;
    height: 1.75rem;
    border-radius: var(--radius-sm);
  }

  .catalogSkeletonText {
    display: grid;
    gap: var(--spacing-3xs);
    padding-top: var(--spacing-2xs);
  }

  .catalogSkeletonLine {
    height: 0.8rem;
    border-radius: var(--radius-sm);
  }

  .catalogSkeletonLineShort {
    width: 65%;
  }

  aside {
    background-color: color-mix(in oklch, var(--muted) 15%, transparent);
    padding: var(--spacing-2xs);
    min-width: 28ch;

    @media (width < 768px) {
      background-color: var(--background);
      position: fixed;
      inset: 0;
      display: none;
      height: 100dvh;
      z-index: 20;
      overflow-y: auto;
      padding: 0 0 var(--spacing-2xl) 0;

      &.mobileFiltersOpen {
        display: block;
      }
    }
  }
  .filter legend {
    font-weight: bold;
    font-size: var(--text-base);
    line-height: 1.1;

    padding-inline: 0.2em;
    margin-left: var(--section-padding-x);
    @media (width >= 768px) {
      margin-left: 1em;
    }
  }

  /*TODO: add pseudo element gradients just like in product form's listboxes*/
  /*TODO: add those same gradients horizontally on mobile*/
  /*TODO: make the scrollbar always visible on mobile*/
  .filter {
    padding-top: 0;
    padding-bottom: var(--spacing-3xs);
    padding-inline: 0;

    @media (width < 768px) {
      border: none;
      min-width: 0;
    }
  }

  .filter-options {
    max-height: 20rem;
    overflow-y: auto;
    border-radius: 0;
    display: grid;
    padding-top: var(--spacing-2xs);

    @media (width < 768px) {
      display: flex;
      gap: var(--spacing-3xs);
      padding-bottom: var(--spacing-3xs);
      padding-inline: var(--spacing-3xs);
    }
  }

  :global(.checkbox-wrapper) {
    padding: var(--spacing-3xs);

    &:hover {
      background-color: var(--muted);
    }

    @media (width < 768px) {
      border: var(--border-width) solid var(--border);
      padding-inline: var(--spacing-xs) !important;
      padding-block: var(--spacing-2xs) !important;
      border-radius: var(--radius-sm);
      background-color: color-mix(in oklch, var(--muted) 15%, transparent);
    }
  }
</style>

<!-- TODO: add "load more" feature or make the filtration work with pagination -->

<script>
  import { initCatalogFiltering } from "@/scripts/catalogFiltering";

  void initCatalogFiltering();
</script>
