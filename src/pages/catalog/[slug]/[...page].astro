---
import type { Page } from "astro";
import ProductCard from "@/components/shared/ProductCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllProductsByCategory } from "@/db/storefront/products/allProductsByCategory";
import type { Category } from "@/db/schema";
import Pagination from "@/components/shared/Pagination.astro";
import { getAllCategories } from "@/db/storefront/allCategories";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Icon } from "astro-icon/components";

export const prerender = true;

type Props = {
  page: Page<any>;
  category: Category;
};
const { slug } = Astro.params;

if (!slug) return Astro.redirect("/catalog");

export async function getStaticPaths({ paginate }: any) {
  const categories = await getAllCategories();

  const results = await Promise.all(
    categories.map(async (category) => {
      const products = (await getAllProductsByCategory(category.id)) ?? [];

      return paginate(products, {
        params: {
          slug: category.slug,
        },
        props: {
          category,
        },
        pageSize: 50,
      });
    }),
  );

  return results.flat();
}

const categoryBaseUrl = `/catalog/${slug}`;

const { page, category } = Astro.props;

const locationLabels = Object.fromEntries(
  STORE_LOCATIONS.map(({ id, address }) => [String(id), address]),
);
---

<!--
TODO: is it possible to make the filters persistent between /catalog/ pages?
currently they flash

TODO: add results and filtered results counts

TODO: add loading state to the filters before they show up

TODO: add filters to mobile
 -->
<Layout title={category.name}>
  <section
    class="no-padding"
    data-category={category.name}
    data-location-labels={JSON.stringify(locationLabels)}>
    <div class="titlePagination">
      <h1 class="text-xl pb-0">{category.name}</h1>
      <Pagination
        data-pagination
        length={page.lastPage}
        currentPage={page.currentPage}
        firstUrl={page.url.first}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        lastUrl={page.url.last}
        baseUrl={categoryBaseUrl}
      />
      <!-- {category.description ? <p>{category.description}</p> : null} -->
    </div>

    <div class="storeLayout">
      <aside>
        <h3>Фильтры</h3>
        <div id="filtersBlock"></div>
        <template id="filter-block-template">
          <div class="filter">
            <label></label>
            <select multiple></select>
            <!-- TODO: implement listbox component instead -->
            <!-- <SelectListBox name="" label="" options={[]} /> -->
          </div>
        </template>
      </aside>
      <div id="staticFeed" class="autoGrid">
        <!-- {
          products ? (
            products.length > 0 ? (
              products.map((product: any) => <ProductCard product={product} />)
            ) : (
              <p>Товаров не найдено</p>
            )
          ) : (
            <p>Товаров не найдено</p>
          )
        } -->
        {
          ((page as any).data || []).map((product: any) => (
            <ProductCard product={product} />
          ))
        }
      </div>
      <div id="filteredFeed" class="autoGrid" hidden></div>
      <template id="product-card-template">
        <a>
          <div class="entityImageWrapper">
            <div class="entityImage"></div>
          </div>

          <div class="flex gap-2xs">
            <span data-card-sale-price></span>
            <p data-card-price></p>
          </div>

          <p class="text-sm" data-card-name></p>
        </a>
      </template>
      <template id="image-placeholder">
        <div class="w-full aspect-square grid place-items-center skeleton">
          <Icon
            name="image"
            title="Сломанная картинка"
            class="size-14 text-muted-foreground"
          />
        </div>
      </template>
    </div>
    <Pagination
      data-pagination
      class="pt-lg pb-xl justify-center w-full"
      length={page.lastPage}
      currentPage={page.currentPage}
      firstUrl={page.url.first}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      lastUrl={page.url.last}
      baseUrl={categoryBaseUrl}
    />
  </section>
</Layout>

<style>
  @media (width > 768px) {
    section {
      padding-right: var(--section-padding-x);
    }
  }
  .storeLayout {
    display: grid;
    grid-template-columns: min-content 1fr;
    @media (width < 768px) {
      grid-template-columns: auto;
    }
  }

  .titlePagination {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-2xs) var(--spacing-md);
    padding-block: var(--spacing-xs) var(--spacing-md);
    padding-inline: var(--section-padding-x);
  }
  aside {
    background-color: color-mix(in oklch, var(--muted) 15%, transparent);
    padding: var(--spacing-2xs);
    min-width: 28ch;
    @media (width < 768px) {
      display: none;
    }
  }
  .filter label {
    font-weight: bold;
  }
  .filter select {
    min-height: 8rem;
  }
  option {
    /*TODO: option is not supposed to have spans within it. how to make count be set to be aligned by right then?*/
    /*display: grid;
    grid-template-columns: 1fr auto 1;
    gap: 1rem;
    align-items: center;*/
  }
</style>

<!-- TODO: add "load more" feature or make the filtration work with pagination -->

<script>
  const desktop = window.matchMedia("(min-width: 769px)");

  if (desktop.matches) {
    void import("@/scripts/catalogFiltering").then(({ initCatalogFiltering }) =>
      initCatalogFiltering(),
    );
  }
</script>
