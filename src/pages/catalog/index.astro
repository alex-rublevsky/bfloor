---
import Layout from "@/layouts/Layout.astro";
import { getAllCategories } from "@/db/storefront/allCategories";
import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";
import { Image } from "astro:assets";
import ImagePlaceholder from "@/components/shared/ImagePlaceholder.astro";
const categories = await getAllCategories();

export const prerender = true;
---

<Layout title=`Каталог — ${SITE_TITLE}`>
  <main>
    <section class="relative no-padding">
      <h1>Каталог</h1>
      <div class="autoGrid pt-sm">
        {
          categories.map((category) => (
            <a href={`/catalog/${category.slug}`}>
              <div class="entityImageWrapper">
                <div class="entityImage">
                  {category.image ? (
                    <Image
                      width={500}
                      height={500}
                      src={BASE_IMAGE_URL + category.image}
                      alt={category.name}
                      class="skeleton"
                      onload="this.closest('.skeleton')?.classList.remove('skeleton')"
                    />
                  ) : (
                    <ImagePlaceholder />
                  )}
                </div>
              </div>
              <h4>{category.name}</h4>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  @media (width < 768px) {
    h1 {
      padding-inline: var(--section-padding-x);
      padding-top: var(--spacing-sm);
    }
    h4 {
      padding-inline: var(--spacing-3xs);
    }
  }
  @media (width > 769px) {
    section {
      padding-inline: var(--section-padding-x);
    }
  }
</style>
