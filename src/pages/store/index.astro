---
import Layout from "@/layouts/Layout.astro";
import { getAllCategories } from "@/db/storefront/allCategories";
import { BASE_IMAGE_URL } from "@/constants";
import { Image } from "astro:assets";
import ImagePlaceholder from "@/components/shared/ImagePlaceholder.astro";
const categories = await getAllCategories();

export const prerender = true;
---

<Layout>
  <main>
    <section class="relative no-padding">
      <h1
        class="sticky left-2xs top-2xs pb-0 px-2xs bg-background/70 backdrop-blur-xs rounded-sm inline z-10">
        Каталог
      </h1>
      <div class="autoGrid pt-sm">
        {
          categories.map((category) => (
            <a href={`/store/${category.slug}`}>
              <div class="entityImageWrapper">
                <div class="entityImage">
                  {category.image ? (
                    <Image
                      width={500}
                      height={500}
                      src={BASE_IMAGE_URL + category.image}
                      alt={category.name}
                    />
                  ) : (
                    <ImagePlaceholder />
                  )}
                </div>
              </div>
              <h5>{category.name}</h5>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  h5 {
    padding-top: var(--spacing-3xs);
    font-weight: 500;
    line-height: 105%;
  }
</style>
