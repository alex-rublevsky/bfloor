---
import ProductCard from "@/components/shared/ProductCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getCategoryBySlug } from "@/db/storefront/getCategoryBySlug";
import { getAllProductsByCategory } from "@/db/storefront/products/allProductsByCategory";
import type { Category } from "@/db/schema";
// import Filters from "@/components/Filters.astro";

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/store");

const category: Category | null = await getCategoryBySlug(slug);

if (!category) return Astro.redirect("/404");

const page = 1;
const products = await getAllProductsByCategory(category.id, page);
---

<Layout title={category.name}>
  <section>
    <div>
      <h1 class="text-lg">{category.name}</h1>
      <p>{category.description ?? "Описание ещё не добавлено"}</p>
    </div>
    <div class="storeLayout">
      <div class="bg-muted/30"><h2>Фильтры</h2></div>
      <div class="autoGrid">
        {
          products ? (
            products.length > 0 ? (
              products.map((product: any) => <ProductCard product={product} />)
            ) : (
              <p>Товаров не найдено</p>
            )
          ) : (
            <p>Товаров не найдено</p>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .storeLayout {
    display: grid;
    grid-template-columns: auto 1fr;
  }
</style>
