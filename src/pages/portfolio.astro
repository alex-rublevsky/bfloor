---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
export const prerender = true;
import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";

const data = [
  { name: "", description: "", year: "", logo: "", photos: ["", ""] },
];
---

<!-- TODO: дописать описание -->
<Layout title=`Наши работы — ${SITE_TITLE}` description="мы работаем с...">
  <section>
    <h1>Наши работы</h1>
    <div class="autoGrid">
      {
        data.forEach((entry) => (
          <a href="">
              <Image src={BASE_IMAGE_URL + entry.photos[0]} width={500} height={500} alt=`Изображение объекта ${entry.name}` />
            <h4>{entry.name}</h4>
            <span>{entry.year}</span>
            {entry.logo ?? (
              <Image src={BASE_IMAGE_URL + entry.logo} width={100} height={100} alt="" />
            )}
            <p>{entry.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style></style>
