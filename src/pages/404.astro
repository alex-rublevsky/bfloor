---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
export const prerender = true;
import { BASE_IMAGE_URL, SITE_TITLE } from "@/constants";
import Button from "@/components/shared/Button.astro";
---

<Layout
  title=`Страница не найдена — ${SITE_TITLE}`
  description="Возможно страница была удалена или переименована">
  <main class="grid place-items-center">
    <div class="blockWrapper">
      <Image
        src={BASE_IMAGE_URL + "other/bubisha-404.jpg"}
        width={1000}
        height={1000}
        alt="Заяц Маскот"
        loading="eager"
        class="skeleton"
        onload="this.closest('.skeleton')?.classList.remove('skeleton')"
      />
      <!-- TODO: make "404" to be a visible text placeholder for the image -->
      <h1 class="sr-only text-[6rem] font-thin text-secondary">404</h1>
      <h3 class="font-normal pt-md pb-sm text-foreground-muted">
        Страница не найдена
      </h3>

      <Button class="w-full" href="/" size="lg">Вернуться на главную</Button>
    </div>
  </main>
</Layout>

<style>
  .blockWrapper {
    display: grid;
    justify-items: center;
    @media (width < 768px) {
      translate: 0 -1.4rem;
    }
  }
  img {
    border-radius: var(--radius-md);
    width: min(80vw, 23rem);
  }
</style>
