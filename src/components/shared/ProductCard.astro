---
import { BASE_IMAGE_URL } from "@/constants";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { getUnitOfMeasurement } from "@/lib/units";
import { getProductCardImage } from "@/lib/productCardImage";
import type { StorefrontProductCard } from "@/db/storefront/products/types";

interface Props {
  product: StorefrontProductCard;
}
//import type { Product } from "@/db/storefront/allProductsForFeed";

//type Props = { product?: Product };

const { product } = Astro.props;
//as Props;

if (!product) {
  return null;
}

const { images } = product;
const cardImage = images?.[0]
  ? await getProductCardImage(BASE_IMAGE_URL + images[0])
  : null;
const unitOfMeasurement =
  getUnitOfMeasurement(product.unitOfMeasurement)?.value ??
  product.unitOfMeasurement;

const price = Intl.NumberFormat()
  .format(Number(product.price))
  .replaceAll(",", " ");
const discountedPrice = product.discountedPrice
  ? Intl.NumberFormat()
      .format(Number(product.discountedPrice))
      .replaceAll(",", " ")
  : undefined;
---

<a href={`/product/${product.slug}`}>
  <div class="entityImageWrapper">
    <div class:list={["entityImage", cardImage && "skeleton"]}>
      {
        cardImage ? (
          <img
            src={cardImage.src}
            width={500}
            height={500}
            alt={product.name}
            loading="lazy"
            decoding="async"
            onload="this.closest('.entityImage')?.classList.remove('skeleton')"
            onerror="this.closest('.entityImage')?.classList.remove('skeleton')"
          />
        ) : (
          <ImagePlaceholder />
        )
      }
    </div>
  </div>
  <div class="productPrices">
    {product.hasVariations ? <span class="fromLabel">от</span> : undefined}
    {
      discountedPrice ? (
        <>
          <span class="price">{discountedPrice}</span>
          {unitOfMeasurement ? (
            <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
          ) : undefined}
        </>
      ) : null
    }
    <span class={`${discountedPrice ? "discountedPrice" : "price"}`}>
      {price}
    </span>

    {
      !discountedPrice && unitOfMeasurement ? (
        <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
      ) : null
    }
  </div>
  <p class="productName text-sm">{product.name}</p>
</a>
