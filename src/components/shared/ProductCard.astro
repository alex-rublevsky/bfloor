---
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { getUnitOfMeasurement } from "@/lib/units";
import type { StorefrontProductCard } from "@/db/storefront/products/types";

interface Props {
  product: StorefrontProductCard;
}
//import type { Product } from "@/db/storefront/allProductsForFeed";

//type Props = { product?: Product };

const { product } = Astro.props;
//as Props;

if (!product) {
  return null;
}

const { images } = product;
const unitOfMeasurement =
  getUnitOfMeasurement(product.unitOfMeasurement)?.value ??
  product.unitOfMeasurement;
---

<a href={`/product/${product.slug}`}>
  <div class="entityImageWrapper">
    <div class="entityImage">
      <!-- TODO: fix some horizontal images not taking up full height, e.g. rulonnoe-rezinovoe-pokrytie-yolochka -->
      <!-- TODO: perhaps integrate getImage for aproppriate image sizes, just like BannerImage.astro -->
      {
        images ? (
          <Image
            src={BASE_IMAGE_URL + images[0]}
            width={500}
            height={500}
            alt={product.name}
            loading="lazy"
            class="skeleton"
            onload="this.closest('.skeleton')?.classList.remove('skeleton')"
          />
        ) : (
          <ImagePlaceholder />
        )
      }
    </div>
  </div>
  <div id="productPrices">
    {
      product.discountedPrice ? (
        <>
          {product.hasVariations ? (
            <span class="fromLabel">от</span>
          ) : undefined}
          <span class="price">{product.discountedPrice}</span>
          {unitOfMeasurement ? (
            <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
          ) : undefined}
        </>
      ) : null
    }
    {product.hasVariations ? <span class="fromLabel">от</span> : undefined}
    <span class={`${product.discountedPrice ? "discountedPrice" : "price"}`}>
      {product.price}
    </span>

    {
      !product.discountedPrice && unitOfMeasurement ? (
        <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
      ) : null
    }
  </div>
  <p id="productName" class="text-sm">{product.name}</p>
</a>
