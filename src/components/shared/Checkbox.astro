---
interface Props {
  name?: string;
  value?: string;
  disabled?: boolean;
  checked?: boolean;
}

const { name, value, disabled, checked, ...rest } = Astro.props;
---

<label class="checkbox-wrapper">
  <input
    type="checkbox"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    class="checkbox-input"
    {...rest}
  />
  <slot />
</label>

<style>
  .checkbox-wrapper {
    display: inline-flex;
    flex-wrap: nowrap;
    gap: var(--spacing-3xs);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    & input {
      align-self: center;
    }
  }
</style>
