---
interface Props {
  as?: "input" | "textarea";
  value?: string | number | null;
  name: string;
  id?: string;
  type?: "text" | "email" | "number" | "tel" | "password";
  placeholder?: string;
  label?: string;
  required?: boolean;
  error?: string[];
  step?: number | string;
  rows?: number;
  disabled?: boolean;
  readonly?: boolean;
  autocomplete?: string;
  minlength?: string;
  autofocus?: boolean;
}

const {
  as = "input",
  value = "",
  name,
  id,
  type = "text",
  placeholder,
  label,
  required,
  error,
  step,
  rows,
  disabled = false,
  readonly = false,
  autocomplete = "off",
  minlength = "0",
  autofocus = false,
  ...rest
} = Astro.props;

const inputId = id ?? `input-${name}`;
const hasLabel = !!label;
const hasError = !!error;
const isTextarea = as === "textarea";
const fieldValue = value ?? "";
---

<!-- TODO: when error is present, the placeholder/label is changing
its position to be lowe... fix

TODO: when the input is readonly={true}, the text should be foreground-muted color -->
<div
  class:list={[
    "input-wrapper",
    { "has-label": hasLabel, "has-error": hasError },
  ]}>
  {
    isTextarea ? (
      <textarea
        id={inputId}
        name={name}
        placeholder={hasLabel ? " " : placeholder}
        class:list={["input-field", "textarea-field", { disabled: disabled }]}
        required={required || undefined}
        aria-invalid={hasError ? "true" : undefined}
        rows={rows}
        disabled={disabled}
        autocomplete={autocomplete}
        {...rest}>
        {fieldValue}
      </textarea>
    ) : (
      <input
        id={inputId}
        value={fieldValue}
        name={name}
        type={type}
        placeholder={hasLabel ? " " : placeholder}
        class:list={["input-field", { disabled: disabled }]}
        required={required || undefined}
        aria-invalid={hasError ? "true" : undefined}
        step={step?.toString()}
        disabled={disabled}
        readonly={readonly}
        autocomplete={autocomplete}
        minlength={minlength}
        autofocus={autofocus}
        {...rest}
      />
    )
  }
  {
    hasLabel && (
      <label for={inputId} class="input-label">
        {label}
      </label>
    )
  }

  <span id={`error-${name}`} role="alert" hidden={!error}>
    {error}
  </span>
</div>

<style>
  .input-wrapper {
    position: relative;
    width: 100%;
  }

  .input-field {
    width: 100%;
    height: 2.75rem;
    padding-inline: 0.75rem;
    padding-block: 0.625rem;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--foreground);
    font-size: inherit;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease-out;
  }

  .input-field::placeholder {
    color: var(--foreground-muted);
  }

  .input-field:focus {
    border-color: var(--primary);
  }

  .has-label .input-field {
    padding-top: 0.7em;
    padding-bottom: 0.25em;
  }

  .textarea-field {
    height: auto;
    min-height: 6rem;
    padding-block: 1.125rem 0.625rem;
    resize: vertical;
  }

  .input-label {
    pointer-events: none;
    position: absolute;
    left: 0.75rem;
    z-index: 1;
    /* Default state: sitting inside the input, vertically centred */
    top: 1.375rem;
    transform: translateY(-50%);
    color: var(--muted-foreground);
    font-size: 1em;
    transition:
      top 0.25s ease-out,
      transform 0.25s ease-out,
      font-size 0.25s ease-out,
      color 0.25s ease-out,
      padding-inline 0.25s ease-out,
      background-color 0.25s ease-out;
  }

  .textarea-field + .input-label {
    top: 1.375rem;
  }

  .input-field:focus + .input-label,
  .input-field:not(:placeholder-shown) + .input-label {
    top: 0;
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: var(--foreground);
    background-color: var(--background);
    padding-inline: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .input-label {
      transition: none;
    }
  }

  .disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .has-error .input-field,
  .has-error .input-field:focus {
    border-color: var(--destructive);
  }

  .has-error .input-field:focus + .input-label,
  .has-error .input-field:not(:placeholder-shown) + .input-label {
    color: var(--destructive);
  }
</style>
