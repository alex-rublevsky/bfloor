---
interface Props {
  as?: "input" | "textarea";
  value?: string | number | null;
  name: string;
  id?: string;
  type?: "text" | "email" | "number" | "tel" | "password";
  placeholder?: string;
  label?: string;
  required?: boolean;
  error?: string[];
  step?: number | string;
  rows?: number;
  disabled?: boolean;
  readonly?: boolean;
  autocomplete?: string;
  minlength?: string;
  autofocus?: boolean;
}

const {
  as = "input",
  value = "",
  name,
  id,
  type = "text",
  placeholder,
  label,
  required,
  error,
  step,
  rows,
  disabled = false,
  readonly = false,
  autocomplete = "off",
  minlength = "0",
  autofocus = false,
  ...rest
} = Astro.props;

const inputId = id ?? `input-${name}`;
const hasLabel = !!label;
const hasError = !!error;
const isTextarea = as === "textarea";
const fieldValue = value ?? "";
---

<!-- TODO: when error is present, the placeholder/label is changing
its position to be lowe... fix

TODO: when the input is readonly={true}, the text should be foreground-muted color -->
<div
  class:list={[
    "input-wrapper",
    { "has-label": hasLabel, "has-error": hasError },
  ]}>
  <div class="input-control">
    {
      isTextarea ? (
        <textarea
          id={inputId}
          name={name}
          placeholder={hasLabel ? " " : placeholder}
          class="input-field textarea-field"
          required={required || undefined}
          aria-invalid={hasError ? "true" : undefined}
          rows={rows}
          disabled={disabled}
          autocomplete={autocomplete}
          {...rest}>
          {fieldValue}
        </textarea>
      ) : (
        <input
          id={inputId}
          value={fieldValue}
          name={name}
          type={type}
          placeholder={hasLabel ? " " : placeholder}
          class="input-field"
          required={required || undefined}
          aria-invalid={hasError ? "true" : undefined}
          step={step?.toString()}
          disabled={disabled}
          readonly={readonly}
          autocomplete={autocomplete}
          minlength={minlength}
          autofocus={autofocus}
          {...rest}
        />
      )
    }
    {
      hasLabel && (
        <label for={inputId} class="input-label">
          {label}
        </label>
      )
    }
  </div>
  <span id={`error-${name}`} role="alert" hidden={!error}>
    {error}
  </span>
</div>

<style>
  /*this padding is to be synced with select's*/
  input {
    padding-inline: var(--spacing-xs);
    padding-block: 0.5em;
  }

  .input-control {
    position: relative;
  }

  .textarea-field {
    height: auto;
    min-height: 6em;
    /*padding-block: 1.125rem 0.625rem;*/
    resize: vertical;
  }

  .input-label {
    pointer-events: none;
    position: absolute;
    left: var(--spacing-xs);
    z-index: 1;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted-foreground);
    font-size: var(--text-base);
    transition: 0.17s ease-out;
  }

  .textarea-field + .input-label {
    top: 1.375rem;
  }

  .input-field:focus + .input-label,
  .input-field:not(:placeholder-shown) + .input-label {
    top: 0;
    translate: calc(-1 * var(--spacing-3xs) / 1.8) -50%;
    font-size: var(--text-xs);
    color: var(--foreground);
    background-color: var(--background);
    padding-inline: var(--spacing-3xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .input-label {
      transition: none;
    }
  }
</style>
