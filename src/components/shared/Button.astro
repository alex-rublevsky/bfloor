---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

type Variant =
  "primary" | "secondary" | "tertiary" | "ghost" | "destructive" | "editorTool";

type Size = "sm" | "default" | "lg";

type Props = Omit<
  HTMLAttributes<"button">,
  keyof {
    variant?: Variant;
    size?: Size;
    href?: string;
  }
> & {
  variant?: Variant;
  size?: Size;
  href?: string;
  name?: string;
  title?: string;
};

const {
  variant,
  size,
  href,
  type,
  name,
  title,
  class: className,
  ...rest
} = Astro.props;

const resolvedVariant = variant ?? "primary";

const variantClasses: Record<Variant, string> = {
  primary: "primary",
  secondary: "secondary",
  tertiary: "tertiary",
  ghost: "ghost",
  destructive: "destructive",
  editorTool: "editorTool",
};

const sizeClasses: Record<Size, string> = {
  sm: "px-2xs py-3xs text-sm",
  default: "px-xs py-2xs",
  lg: "py-xs px-md text-md font-normal [&_svg]:size-6",
};

const variantClass = variantClasses[resolvedVariant];
const sizeClass =
  resolvedVariant === "editorTool" ? "" : sizeClasses[size ?? "default"];
const composedClass = `${variantClass ? ` ${variantClass}` : ""}${sizeClass ? ` ${sizeClass}` : ""}${className ? ` ${className}` : ""}`;
---

{
  href ? (
    <a href={href} class={composedClass} {...rest}>
      <span class="contentWrapper">
        <slot />
      </span>
    </a>
  ) : variant === "editorTool" ? (
    <button type="button" class={composedClass} {...rest}>
      {Astro.slots.has("default") ? (
        <slot />
      ) : name ? (
        <Icon name={name} title={title} />
      ) : null}
    </button>
  ) : (
    <button type={type ?? "button"} class={composedClass} {...rest}>
      <span class="contentWrapper">
        <slot />
      </span>
      <Icon
        aria-hidden="true"
        name="spinner"
        class="spinner size-5 animate-spin"
      />
    </button>
  )
}

<style>
  a,
  button {
    height: min-content;
    display: grid;
    justify-content: center;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    user-select: none;
    & * {
      color: inherit;
    }
    & .contentWrapper {
      font-size: inherit;
      align-items: center;
      gap: var(--spacing-3xs);
      display: inline-flex;
    }
  }

  a {
    color: var(--foreground);
    text-decoration: none;
  }

  button {
    grid-template-areas: "stack";
    place-items: center;
    .contentWrapper,
    .spinner {
      grid-area: stack;
    }
    .spinner {
      visibility: hidden;
    }
    &[aria-busy="true"] {
      .contentWrapper {
        visibility: hidden;
      }
      .spinner {
        visibility: visible;
      }
    }
  }

  button:disabled,
  button[aria-disabled="true"] {
    cursor: not-allowed;
    background-color: color-mix(in oklch, var(--background) 70%, transparent);
    color: color-mix(in oklch, var(--primary) 70%, transparent);
    border-color: color-mix(in oklch, var(--primary) 70%, transparent);
    backdrop-filter: blur(4px);

    &:hover {
      color: color-mix(in oklch, var(--primary) 70%, transparent);
    }
  }

  .primary {
    background-color: var(--primary);
    color: var(--background);
    border: var(--border-width) solid var(--primary);
    &:hover {
      color: var(--primary);
      background-color: color-mix(in oklch, var(--background) 70%, transparent);
      backdrop-filter: blur(4px);
    }
  }
  .secondary {
    background-color: var(--background);
    color: var(--foreground);
    border: var(--border-width) solid var(--primary);
    &:hover {
      color: var(--background);
      background-color: var(--primary);
    }
  }

  .tertiary {
    background-color: color-mix(in oklch, var(--background) 70%, transparent);
    color: var(--foreground);
    border: var(--border-width) solid
      color-mix(in oklch, var(--muted) 80%, transparent);
    backdrop-filter: blur(4px);
    &:hover {
      color: var(--background);
      background-color: var(--primary);
      border-color: var(--primary);
    }
    &[data-active] {
      background-color: var(--primary);
      color: var(--background);
      border-color: var(--primary);
    }
  }

  .ghost {
    justify-content: start;
    white-space: wrap;
    text-align: start;
    &:hover {
      background-color: var(--muted);
    }
  }
  .destructive {
    background-color: var(--destructive);
    color: var(--destructive-foreground);
    border: var(--border-width) solid var(--destructive);
    &:hover {
      background-color: color-mix(
        in oklch,
        var(--destructive) 10%,
        transparent
      );
      color: var(--destructive);
    }
  }
  .editorTool {
    font-weight: bold;
    color: var(--foreground);
    padding: var(--spacing-3xs);

    &:hover {
      background-color: color-mix(in oklch, var(--foreground) 10%, transparent);
    }
    &:active {
      background-color: color-mix(in oklch, var(--foreground) 20%, transparent);
    }
    &.is-active {
      background-color: var(--primary);
      color: var(--background);
    }
    &:disabled {
      opacity: 50%;
    }
    & svg {
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }
</style>
