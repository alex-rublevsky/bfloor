---
import Button from "./Button.astro";

const {
  class: className,
  length,
  currentPage,
  firstUrl,
  prevUrl,
  nextUrl,
  lastUrl,
  baseUrl,
  ...rest
} = Astro.props;
const paginationList = Array.from({ length }, (_, i) => i + 1);
const pageUrl = (pageNumber: number) =>
  pageNumber === 1 ? baseUrl : `${baseUrl}/${pageNumber}`;
---

<!-- TODO: show only a few number buttons when there are many to be displayed — e.g.
on mobile there is horizontal scroll because of it. -->{
  paginationList.length > 1 ? (
    <nav
      aria-label="Страницы каталога"
      class={`${className ?? undefined}`}
      {...rest}>
      {firstUrl ? (
        <Button size="pagination" variant="secondary" href={`${firstUrl}`}>
          &#171;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled href={""}>
          &#171;
        </Button>
      )}

      {prevUrl ? (
        <Button size="pagination" variant="secondary" href={`${prevUrl}`}>
          &#8249;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled href={""}>
          &#8249;
        </Button>
      )}

      {paginationList.map((num) => (
        <Button
          size="pagination"
          variant={currentPage === num ? "primary" : "tertiary"}
          href={pageUrl(num)}
          aria-current={currentPage === num ? "page" : undefined}
          class={` ${currentPage == num ? "disabled active" : ""}`}>
          {num}
        </Button>
      ))}

      {!nextUrl ? (
        <Button size="pagination" variant="secondary" disabled>
          &#8250;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" href={`${nextUrl}`}>
          &#8250;
        </Button>
      )}

      {lastUrl ? (
        <Button size="pagination" variant="secondary" href={`${lastUrl}`}>
          &#187;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled>
          &#187;
        </Button>
      )}
    </nav>
  ) : undefined
}

<style>
  nav {
    display: flex;
    flex-direction: row;
    gap: var(--spacing-3xs);
  }
</style>
