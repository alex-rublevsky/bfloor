---
import Button from "./Button.astro";
import { getPaginationItems } from "@/lib/paginationWindow";

const {
  class: className,
  length,
  currentPage,
  firstUrl,
  prevUrl,
  nextUrl,
  lastUrl,
  baseUrl,
  ...rest
} = Astro.props;
const paginationItems = getPaginationItems(currentPage, length);
const pageUrl = (pageNumber: number) =>
  pageNumber === 1 ? baseUrl : `${baseUrl}/${pageNumber}`;
---

<!-- TODO: show only a few number buttons when there are many to be displayed — e.g.
on mobile there is horizontal scroll because of it. -->
<template data-filtered-pagination-link>
  <Button size="pagination" variant="secondary" href="#" data-filtered-page>
    <span data-pagination-label></span>
  </Button>
</template>
    <nav
      aria-label="Страницы каталога"
      class={`${className ?? undefined}`}
      hidden={length <= 1}
      {...rest}>
      {firstUrl ? (
        <Button size="pagination" variant="secondary" href={`${firstUrl}`}>
          &#171;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled href={""}>
          &#171;
        </Button>
      )}

      {prevUrl ? (
        <Button size="pagination" variant="secondary" href={`${prevUrl}`}>
          &#8249;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled href={""}>
          &#8249;
        </Button>
      )}

      {paginationItems.map((item) =>
        item === "ellipsis" ? (
          <span class="paginationEllipsis" aria-hidden="true">…</span>
        ) : (
          <Button
            size="pagination"
            variant={currentPage === item ? "primary" : "tertiary"}
            href={pageUrl(item)}
            aria-current={currentPage === item ? "page" : undefined}
            class={` ${currentPage == item ? "disabled active" : ""}`}>
            {item}
          </Button>
        ),
      )}

      {!nextUrl ? (
        <Button size="pagination" variant="secondary" disabled>
          &#8250;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" href={`${nextUrl}`}>
          &#8250;
        </Button>
      )}

      {lastUrl ? (
        <Button size="pagination" variant="secondary" href={`${lastUrl}`}>
          &#187;
        </Button>
      ) : (
        <Button size="pagination" variant="secondary" disabled>
          &#187;
        </Button>
      )}
    </nav>
<style>
  nav {
    display: flex;
    flex-direction: row;
    gap: var(--spacing-3xs);
  }

  nav[hidden] {
    display: none;
  }

  :global(.paginationEllipsis) {
    align-self: center;
    padding-inline: var(--spacing-3xs);
  }
</style>
