---
interface Props {
    name: string;
    selectedOption?: number;
    options: { id: number; name: string }[];
    label: string;
    required?: boolean;
    disabled?: boolean;
}
const {
    name,
    selectedOption,
    options,
    label,
    required = false,
    disabled = false,
} = Astro.props;
---

<div>
    <label for={name}>{label}:</label>

    <select name={name} id={name} value={selectedOption} required={required}>
        <option value="">— Выбрать —</option>
        {
            options.map((option: { id: number; name: string }) => (
                <option
                    selected={option.id === selectedOption}
                    value={option.id}
                >
                    {option.name}
                </option>
            ))
        }
    </select>
</div>
