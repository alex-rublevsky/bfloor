---
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";
import Button from "@/components/shared/Button.astro";
---

<section class="grid md:grid-cols-2 gap-md">
  <Image
    src={BASE_IMAGE_URL + "about/elena.webp"}
    width={2120}
    height={1416}
    alt="Директор"
    loading="lazy"
    class="skeleton rounded-lg w-full"
    onload="this.closest('.skeleton')?.classList.remove('skeleton')"
    style="view-transition-name: about-image;"
  />

  <div>
    <h2 class="text-xl" style="view-transition-name: about-title;">
      О компании
    </h2>
    <p style="view-transition-name: about-paragraph;">
      У нас большой выбор напольных покрытий, для домов, офисов, спортивных
      площадок и других мест отдыха. Мы предоставляем не только
      высококачественную продукцию, но и необходимые инструменты для укладки и
      ухода. Наши специалисты квалифицированно установят напольное покрытие и
      дадут рекомендации.
    </p>
    <Button class="mt-xs" href="/about" variant="tertiary">Подробнее</Button>
  </div>
</section>
