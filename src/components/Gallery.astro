---
import { BASE_IMAGE_URL } from "@/constants";
import { Image } from "astro:assets";
interface Props {
  images: string[];
}

const { images, ...rest } = Astro.props;
---

<div class="gallery">
  <div id="previewRow">
    {
      images.map((img, index) => (
        <button class="previewButton">
          <Image
            src={BASE_IMAGE_URL + img}
            width={100}
            height={100}
            fit="cover"
            id="preview"
            alt={`Превью изображение галереи номер ${index + 1}`}
            data-index={index}
            class:list={index === 0 ? "is-active" : undefined}
          />
        </button>
      ))
    }
  </div>
  <div class="mainImageWrapper">
    {
      images.map((img, index) => (
        <img data-index={index} id="mainImage" src={BASE_IMAGE_URL + img} />
      ))
    }
  </div>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--spacing-3xs);
  }
  button:active::after {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in oklch, var(--muted) 15%, transparent);
    pointer-events: none;
  }

  img#mainImage {
    display: none;
    /*TODO: make this responsive through cqh*/
    max-height: calc(100dvh - 8rem);
    &[data-index="0"] {
      display: block;
    }
  }

  button {
    position: relative;
    /*border-radius: var(--radius-sm);*/
    overflow: clip;
  }

  button:has(img.is-active)::after {
    content: "";
    position: absolute;
    inset: 0;
    border: var(--border-width-thick) solid var(--accent);
    pointer-events: none;
    /*border-radius: var(--radius-sm);*/
  }
  #previewRow {
    display: grid;
    gap: var(--spacing-3xs);
  }

  .previewButton {
    aspect-ratio: 1/1;
    max-width: 4rem;
  }
  img#preview {
    object-fit: cover;
    height: 100%;
    width: auto;
    /*height: clamp(3.5rem, 7vw, 5rem);*/
    /*height: 100%;*/
    /*width: auto;*/
    /*max-height: 2rem;*/
    /*justify-content: start;*/
    /*object-fit: cover;*/
  }
</style>
<script>
  const previewRow = document.getElementById("previewRow") as HTMLElement;
  const mainImage = document.querySelectorAll<HTMLElement>("#mainImage");
  const previews = document.querySelectorAll<HTMLElement>("#preview");

  previewRow.onclick = function (event) {
    let preview = (event.target as HTMLElement).closest(
      "#preview",
    ) as HTMLElement;
    if (!preview || !previewRow.contains(preview)) return;
    previews.forEach((preview) => {
      preview.classList.remove("is-active");
    });

    preview.classList.add("is-active");
    mainImage.forEach((mainImage) => {
      mainImage.style.display = "none";
    });
    mainImage[Number(preview.dataset.index)].style.display = "block";
  };
</script>
