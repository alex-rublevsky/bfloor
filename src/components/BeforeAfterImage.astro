---
import { BASE_IMAGE_URL } from "@/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
  beforeSrc: string;
  afterSrc: string;
  alt: string;
}

const { beforeSrc, afterSrc, alt } = Astro.props;
---

<div class="container">
  <div class="image-container">
    <Image
      src={beforeSrc}
      width={1000}
      height={1000}
      alt=""
      class="image-before"
    />

    <Image
      src={afterSrc}
      width={1000}
      height={1000}
      alt=""
      class="image-after"
    />
  </div>
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    class="slider"
    aria-label="Процент показанного до фото"
  />
  <div class="slider-line"></div>

  <div class="slider-button" aria-hidden="true">
    <Icon name="arrows-horizontal" title="Горизонтальные стрелочки" />
  </div>
</div>

<style>
  .container {
    display: grid;
    place-content: center;
    position: relative;
    overflow: clip;
    border-radius: var(--radius-sm);

    --position: 50%;
  }

  .image-container {
    max-width: 800px;
    max-height: 90vh;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
  }

  .image-before {
    position: absolute;
    inset: 0;
    width: var(--position);
  }

  .slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    opacity: 0;
    /*for firefox*/
    width: 100%;
    height: 100%;
  }

  .slider:focus-visible ~ .slider-button {
    outline: var(--border-width) solid var(--accent);
    outline-offset: var(--border-width);
  }

  .slider-line {
    position: absolute;
    inset: 0;
    width: 0.2rem;
    height: 100%;
    background-color: var(--background);
    z-index: 10;
    left: var(--position);
    translate: -50% 0;
    pointer-events: none;
  }

  .slider-button {
    position: absolute;
    background-color: var(--background);
    color: var(--foreground);
    padding: var(--spacing-3xs);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    top: 50%;
    left: var(--position);
    translate: -50% 0;
    pointer-events: none;
    z-index: 11;
    box-shadow: 1px 1px 1px rgba(0, 0, 0, 0.15);
  }
</style>

<script>
  const container = document.querySelector(".container") as HTMLElement;
  document.querySelector(".slider")?.addEventListener("input", (e) => {
    container.style.setProperty(
      "--position",
      `${(e.target as HTMLInputElement).value}%`,
    );
  });
</script>
