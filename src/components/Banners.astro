---
import BannerImage from "@/components/BannerImage.astro";
import { BASE_IMAGE_URL } from "../constants";

const bannerImages = [
  {
    desktopImage: "banners/cork.jpg",
    mobileImage: "banners/cork-mobile.jpg",
    alt: "Настенная пробка всегда в наличии",
    href: "/catalog/wall-cork",
  },
  // TODO: update the href to lead to filtered to ёлочка category
  {
    desktopImage: "banners/elochka.webp",
    mobileImage: "banners/elochka-mobile.webp",
    alt: `Ламинат "Ëлочкой". BeautyFloor — эксклюзивный представитель ламината CBM на Дальнем Востоке`,
    href: "/catalog/laminate",
  },
  {
    desktopImage: "banners/sale.webp",
    mobileImage: "banners/sale-mobile.webp",
    alt: "Распродажа остатков! 100+ позиций",
    href: "/catalog/rasprodazha-ostatkov",
  },
];
---

<!-- TODO: add smooth transition between banners -->
<section class="no-padding">
  <div id="banners">
    <!-- TODO: is there "priority" or "loading="eager" tag for picture element? -->
    {
      bannerImages.map((image, index) => (
        <a href={image.href}>
          <BannerImage
            id="banner"
            mobileImgUrl={BASE_IMAGE_URL + image.mobileImage}
            desktopImgUrl={BASE_IMAGE_URL + image.desktopImage}
            alt={image.alt}
            data-index={index}
          />
        </a>
      ))
    }
  </div>
  <div id="previewRow">
    {
      bannerImages.map((image, index) => (
        <button>
          <BannerImage
            id="preview"
            mobileImgUrl={BASE_IMAGE_URL + image.mobileImage}
            desktopImgUrl={BASE_IMAGE_URL + image.desktopImage}
            alt={image.alt}
            data-index={index}
            class:list={index === 0 ? "is-active" : undefined}
          />
        </button>
      ))
    }
  </div>
</section>

<style>
  section {
    display: grid;
    align-items: start;

    & a {
      display: block;
    }
    & button {
      position: relative;
      border-radius: var(--radius-xs);
      overflow: clip;

      &:has(picture.is-active)::after {
        content: "";
        position: absolute;
        inset: 0;
        border: var(--border-width-thick) solid var(--accent);
        pointer-events: none;
        border-radius: var(--radius-xs);
      }
    }

    picture {
      user-select: none;
      object-fit: cover;

      &#banner {
        display: none;

        &[data-index="0"] {
          display: block;
        }

        & :global(img) {
          aspect-ratio: 1100/550;
        }
      }
    }

    a:active::after,
    button:active::after {
      content: "";
      position: absolute;
      inset: 0;
      background: color-mix(in oklch, var(--muted) 15%, transparent);
      pointer-events: none;
    }

    & #previewRow {
      display: flex;
      gap: var(--spacing-2xs);
      padding: var(--spacing-2xs);
      & picture#preview :global(img) {
        height: clamp(3.5rem, 7vw, 5rem);
        aspect-ratio: 5 / 3;
        object-fit: cover;
      }
    }

    @media (width >= 800px) {
      grid-template-areas: "previews banners";
      grid-template-columns: auto 1fr;
      & #previewRow {
        display: grid;
        grid-area: previews;
      }
      & #banners {
        overflow: clip;
        grid-area: banners;
        margin-right: var(--spacing-2xs);
      }
      a:active {
        transform: scale(0.99);
      }
      & picture#banner :global(img) {
        aspect-ratio: 1920/550;
        border-radius: var(--radius-md);
      }
    }
  }
</style>

<script>
  const previewRow = document.getElementById("previewRow") as HTMLElement;
  const banners = document.querySelectorAll<HTMLElement>("#banner");
  const previews = document.querySelectorAll<HTMLElement>("#preview");

  previewRow.onclick = function (event) {
    let preview = (event.target as HTMLElement).closest(
      "#preview",
    ) as HTMLElement;
    if (!preview || !previewRow.contains(preview)) return;
    previews.forEach((preview) => {
      preview.classList.remove("is-active");
    });

    preview.classList.add("is-active");
    banners.forEach((banner) => {
      banner.style.display = "none";
    });
    banners[Number(preview.dataset.index)].style.display = "block";
  };
</script>
