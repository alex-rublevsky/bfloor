---
import { getAllBrands } from "@/db/storefront/allBrands";
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";
const brands = await getAllBrands();
const brandsWithImages = brands.filter((brand) => brand.image);
---

<section class="no-padding">
  <!-- TODO: show the total number
    TODO: make it a link to all brands page -->
  <h2>Наши Партнёры</h2>
  <div class="carousel">
    <div class="group">
      <!-- TODO: fix the links to brand pages when those are working -->
      <!-- href={"catalog/" + brand.slug} -->
      {
        brandsWithImages.map((brand) => (
          <a>
            <Image
              src={BASE_IMAGE_URL + brand.image}
              height={300}
              width={300}
              fit="contain"
              class="skeleton"
              onload="this.closest('.skeleton')?.classList.remove('skeleton')"
              alt={"Логотип бренда " + brand.name}
            />
          </a>
        ))
      }
    </div>
    <div aria-hidden class="group">
      <!-- TODO: fix the links to brand pages when those are working -->
      <!-- href={"catalog/" + brand.slug} -->
      {
        brandsWithImages.map((brand) => (
          <a>
            <Image
              src={BASE_IMAGE_URL + brand.image}
              height={300}
              width={300}
              fit="contain"
              class="skeleton"
              onload="this.closest('.skeleton')?.classList.remove('skeleton')"
              alt={"Логотип бренда " + brand.name}
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  h2 {
    padding-inline: var(--section-padding-x);
  }
  .carousel {
    overflow-x: auto;
    scrollbar-width: none;
    display: flex;
    overflow: hidden;
    touch-action: pan-y;
    pointer-events: none;

    & a {
      pointer-events: auto;
      background-color: var(--background);

      &:hover {
        background-color: var(--muted);
      }
      & img {
        width: clamp(8rem, 20vw, 13rem);
        aspect-ratio: 1/1;
        object-fit: contain;
        mix-blend-mode: darken;
        padding: var(--spacing-2xs);
        user-select: none;
        pointer-events: none;
      }
    }
  }

  .group {
    --speed: 80s;
    display: flex;
    flex: 0 0 auto;
    animation: spin var(--speed) infinite linear;
    @media (min-width: 768px) {
      --speed: 70s;
    }
  }

  @keyframes spin {
    from {
      translate: 0;
    }
    to {
      translate: -100%;
    }
  }
</style>

<script>
  const carousel = document.querySelector(".carousel");
  const groups = carousel?.querySelectorAll(".group");

  function setSpeed(rate: any) {
    groups?.forEach((group) => {
      group.getAnimations().forEach((animation) => {
        animation.updatePlaybackRate(rate);
      });
    });
  }

  carousel?.addEventListener("pointerenter", () => setSpeed(0.5));
  carousel?.addEventListener("pointerleave", () => setSpeed(1));
</script>
