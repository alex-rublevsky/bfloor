---
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Link from "@/components/shared/Link.astro";
---

<div class="bottomBar">
  <div class="flex gap-2xs justify-center md:justify-end">
    <div class="flex gap-2xs md:hidden">
      <Button size="md" href="/" variant="tertiary">Главная</Button>

      <Button size="md" href="/store">Каталог</Button>
      <div class="dropdown flex" data-dropdown>
        <Button size="md" data-dropdown-button>Ещё</Button>
        <div
          class="dropdown-menu flex flex-col items-start gap-xs whitespace-nowrap">
          <Link href="/delivery">Доставка и Оплата</Link>
          <Link href="/contact">Контакты и Адреса</Link>
          <Link href="/about">О компании</Link>

          <Button size="md" href="/dashboard">Админка</Button>
        </div>
      </div>
    </div>
    <Button class="aspect-square" size="md" variant="tertiary">
      <Icon name="cart" title="Корзина" />
    </Button>
  </div>
</div>

<style>
  .bottomBar {
    position: fixed;
    left: var(--spacing-2xs);
    right: var(--spacing-2xs);
    bottom: var(--spacing-2xs);
    z-index: 10;
  }
</style>
