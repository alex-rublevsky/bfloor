---
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Link from "@/components/shared/Link.astro";
---

<nav>
  <Button href="/" variant="tertiary">Главная</Button>

  <Button href="/store">Каталог</Button>

  <Button variant="tertiary" popovertarget="bottom-menu">Ещё</Button>
  <div id="bottom-menu" popover class="menu menu--above">
    <Button variant="ghost" href="/delivery">Доставка и Оплата</Button>
    <Button variant="ghost" href="/contact">Контакты и Адреса</Button>
    <Button variant="ghost" href="/about">О компании</Button>
    <!-- TODO: make admin button be visible only when admin flag is present -->
    <!-- <Button size="md" href="/dashboard">Админка</Button> -->
  </div>
</nav>

<style>
  nav {
    display: flex;
    gap: var(--spacing-2xs);
    justify-content: center;
    position: fixed;
    left: var(--spacing-2xs);
    right: var(--spacing-2xs);
    bottom: var(--spacing-2xs);
    z-index: 10;
    @media (min-width: 768px) {
      display: none;
    }
  }
</style>
