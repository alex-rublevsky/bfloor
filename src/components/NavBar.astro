---
import Button from "./shared/Button.astro";
import Link from "@/components/shared/Link.astro";
import { Icon } from "astro-icon/components";
import Input from "./shared/Input.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<nav>
  <div class="hidden md:flex gap-sm items-stretch">
    <Link href="/" class="self-center">
      <Icon name="logo" title="Лого BeautyFloor" />
    </Link>
    <Button size="md" href="/store">Каталог</Button>
  </div>
  <!-- TODO: integrate number of items in the placeholder  -->

  <!-- TODO: make the search stable, fix indexing of images, titles, etc. -->
  <!-- <div class="flex-1">
    <PagefindConfig excerpt-length="10" />
    <pagefind-input placeholder="Поиск"></pagefind-input>
  </div> -->
  <div class="hidden xl:flex xl:gap-xs xl:items-stretch whitespace-nowrap">
    <Link href="/delivery" class="self-center">Доставка</Link>
    <Link href="/contact" class="self-center">Контакты и Адреса</Link>
    <Link href="/about" class="self-center">О компании</Link>
    <!-- <Button>
      <Icon name="phone" title="phone" />
    </Button> -->
    <!-- TODO: make this show up only when admin tag is present -->
    <!-- <Button size="md" href="/dashboard">Админка</Button> -->
  </div>
  <div class="hidden md:flex gap-xs xl:hidden">
    <Button popovertarget="top-menu" size="md">Ещё</Button>
  </div>
  <div id="top-menu" popover class="menu">
    <Button variant="ghost" href="/delivery">Доставка</Button>
    <Button variant="ghost" href="/contact">Контакты и Адреса</Button>
    <Button variant="ghost" href="/about">О компании</Button>
    <!-- TODO: make admin button be visible only when admin flag is present -->
    <!-- <Button href="/dashboard">Админка</Button> -->
  </div>
</nav>
<div>
  <pagefind-summary></pagefind-summary>
  <pagefind-results show-images="true"></pagefind-results>
</div>
<style>
  nav {
    position: sticky;
    inset: 0;
    z-index: 99;
    background-color: var(--background);
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--spacing-2xs);
    padding: var(--spacing-2xs);
    height: 3.5rem;
  }

  :root {
    --pf-outline-focus: var(--primary);
    --pf-outline-width: var(--border-width);
    --pf-background: var(--background);
    --pf-font: var(--font-overused-grotesk);
    --pf-border-radius: var(--radius-sm);

    pagefind-input {
      --pf-border: var(--border);
      /*hover for the "clear" button:*/
      --pf-hover: var(--muted);
      --pf-text-muted: var(--foreground);
      --pf-border: var(--border);

      --pf-input-height: calc(3.5rem - 2 * var(--spacing-2xs));
      --pf-input-font-size: var(--text-sm);
    }
    pagefind-results {
      --pf-border: var(--border);
      /*this actually changes the active color:*/
      --pf-hover: var(--muted);
    }
    pagefind-summary {
      --pf-text-muted: var(--foreground-muted);
      --pf-summary-font-size: var(--text-sm);
      padding-left: var(--spacing-2xs);
    }
  }
</style>
<script>
  // TODO:
  //   1. integrate custom components e.g. to use a custom clear button, etc.
  //   2. try grid styling for the results
  //   3. how to change result's border color on hover

  import { getInstanceManager } from "@pagefind/component-ui";

  const instance = getInstanceManager().getInstance("default");

  instance.setTranslations({
    clear_search: "Очистить",
  });
</script>
