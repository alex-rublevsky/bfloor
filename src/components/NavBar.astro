---
import Button from "./shared/Button.astro";
import Link from "@/components/shared/Link.astro";
import { Icon } from "astro-icon/components";
---

<nav
    class="flex justify-between items-center gap-(--fluid-sm) px-(--fluid-sm) py-(--fluid-xs)"
>
    <Link href="/">
        <Icon name="logo" title="Лого BeautyFloor" class="text-blue-200" />
    </Link>
    <div class="flex gap-(--fluid-sm)">
        <Link href="/about">О компании</Link>
        <Link href="/contact">Контакты и Адреса</Link>

        <Button size="sm" href="/dashboard">Админка</Button>
    </div>
</nav>
