---
import Button from "./shared/Button.astro";
import { Icon } from "astro-icon/components";
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Товары", href: "/dashboard", match: "exact" as const },
  {
    label: "Категории",
    href: "/dashboard/categories",
    match: "exact" as const,
  },
  {
    label: "Бренды",
    href: "/dashboard/brands",
    match: "exact" as const,
  },
  {
    label: "Атрибуты",
    href: "/dashboard/attributes",
    match: "exact" as const,
  },
  // { label: "Заказы", href: "/dashboard/orders", match: "prefix" as const },
  { label: "Прочее", href: "/dashboard/misc", match: "exact" as const },
  // {
  //     label: "Аналитика",
  //     href: "/dashboard/analytics",
  //     match: "prefix" as const,
  // },
];

const createItems = [
  {
    label: "Товар",
    href: "/dashboard",
    hrefTo: "/dashboard/product/new",
    match: "exact" as const,
  },
  {
    label: "Категория",
    href: "/dashboard/categories",
    commandFor: "category-dialog",
    match: "exact" as const,
  },
  {
    label: "Бренд",
    href: "/dashboard/brands",
    dataEntity: "brand",
    commandFor: "brand-dialog",
    match: "exact" as const,
  },
  {
    label: "Атрибут",
    href: "/dashboard/attributes",
    dataEntity: "attribute",
    commandFor: "attribute-dialog",
    match: "exact" as const,
  },
];

const isActive = (href: string, match: "exact" | "prefix") =>
  match === "exact"
    ? pathname === href
    : pathname === href || pathname.startsWith(`${href}/`);

const hasCreateButton = (href: string) => pathname === href;
---

<nav>
  <div class="leftBlock">
    <div class="navItemsWrapper">
      <!-- TODO: all button variants except for ghost have bg-transition class. why does it not work in these links? -->
      {
        navItems.map((item) => (
          <Button
            size="sm"
            href={item.href}
            variant="tertiary"
            data-active={isActive(item.href, item.match) ? "" : undefined}>
            {item.label}
          </Button>
        ))
      }

      <Button size="sm" class="store-button mobile" variant="tertiary" href="/"
        >Магазин</Button
      >
    </div>

    {
      createItems.map((item) => (
        <Button
          class="createButton"
          href={item.hrefTo}
          data-entity={item.dataEntity ?? undefined}
          data-mode={item.commandFor ? "create" : undefined}
          command={item.commandFor ? "show-modal" : undefined}
          commandfor={item.commandFor ?? undefined}
          style={hasCreateButton(item.href) ? null : "display: none"}>
          <Icon name="plus" title={`Создать ${item.label}`} />
          {item.label}
        </Button>
      ))
    }
  </div>

  <Button class="store-button desktop" variant="tertiary" href="/"
    >Магазин</Button
  >
</nav>

<style>
  a {
    display: block;
  }
  nav {
    position: fixed;
    left: var(--spacing-3xs);
    right: var(--spacing-3xs);
    top: var(--spacing-3xs);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-sm);
    justify-content: space-between;
    z-index: 2;
    pointer-events: none;

    .createButton {
      align-self: center;
    }
    .store-button {
      align-self: center;
      pointer-events: auto;
      &.mobile {
        display: none;
      }
    }

    .leftBlock {
      display: flex;
      flex-direction: row;
      gap: var(--spacing-3xs);
      pointer-events: auto;
    }
    .navItemsWrapper {
      display: flex;
      gap: var(--spacing-3xs);
      background-color: color-mix(in oklch, var(--background) 70%, transparent);
      border: 0.1rem solid color-mix(in oklch, var(--muted) 70%, transparent);
      padding: var(--spacing-3xs);
      backdrop-filter: blur(0.3rem);
      border-radius: var(--radius-sm);
    }
  }

  @media (width < 768px) {
    nav {
      top: auto;
      bottom: var(--spacing-3xs);
      gap: var(--spacing-3xs);
    }

    .navItemsWrapper {
      flex-wrap: wrap;
    }

    .store-button {
      &.desktop {
        display: none;
      }
      &.mobile {
        display: block;
      }
    }
  }
</style>
