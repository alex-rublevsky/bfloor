---
import Button from "./shared/Button.astro";
import { Icon } from "astro-icon/components";
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Товары", href: "/dashboard", match: "exact" as const },
  {
    label: "Категории",
    href: "/dashboard/categories",
    match: "exact" as const,
  },
  {
    label: "Бренды",
    href: "/dashboard/brands",
    match: "exact" as const,
  },
  {
    label: "Атрибуты",
    href: "/dashboard/attributes",
    match: "exact" as const,
  },
  { label: "Заказы", href: "/dashboard/orders", match: "prefix" as const },
  { label: "Прочее", href: "/dashboard/misc", match: "exact" as const },
  // {
  //     label: "Аналитика",
  //     href: "/dashboard/analytics",
  //     match: "prefix" as const,
  // },
];

const createItems = [
  {
    label: "Товар",
    href: "/dashboard",
    hrefTo: "/dashboard/product/new",
    match: "exact" as const,
  },
  {
    label: "Категория",
    href: "/dashboard/categories",
    hrefTo: "/dashboard/categories/new",
    match: "exact" as const,
  },
  {
    label: "Бренд",
    href: "/dashboard/brands",
    // hrefTo: "/dashboard/brands/new",
    dataEntity: "brand",
    match: "exact" as const,
  },
  {
    label: "Атрибут",
    href: "/dashboard/attributes",
    hrefTo: "/dashboard/attributes/new",
    match: "exact" as const,
  },
];

const isActive = (href: string, match: "exact" | "prefix") =>
  match === "exact"
    ? pathname === href
    : pathname === href || pathname.startsWith(`${href}/`);

const hasCreateButton = (href: string) => pathname === href;
---

<nav>
  <div class="leftBlock">
    <div class="navItemsWrapper">
      <!-- TODO: all button variants except for ghost have bg-transition class. why does it not work in these links? -->
      {
        navItems.map((item) => (
          <Button
            size="sm"
            href={item.href}
            variant="tertiary"
            data-active={isActive(item.href, item.match) ? "" : undefined}>
            {item.label}
          </Button>
        ))
      }
    </div>

    {
      createItems.map((item) => (
        <Button
          size="sm"
          variant="primary"
          href={item.hrefTo}
          data-open-modal={item.dataEntity ? "" : undefined}
          data-entity={item.dataEntity ?? undefined}
          data-mode={item.dataEntity ? "create" : undefined}
          style={hasCreateButton(item.href) ? null : "display: none"}>
          <Icon name="plus" title={`Создать ${item.label}`} />
          {item.label}
        </Button>
      ))
    }
  </div>

  <Button size="sm" class="store-button" variant="primary" href="/"
    >Магазин</Button
  >
</nav>

<style>
  nav {
    position: fixed;
    left: var(--spacing-3xs);
    right: var(--spacing-3xs);
    top: var(--spacing-3xs);
    display: flex;
    flex-direction: row;
    gap: var(--spacing-sm);
    align-items: stretch;
    justify-content: space-between;
    z-index: 2;
    pointer-events: none;
  }

  .leftBlock {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--spacing-3xs);
    pointer-events: auto;
  }
  .navItemsWrapper {
    display: flex;
    gap: var(--spacing-3xs);
    background-color: color-mix(in oklch, var(--background) 70%, transparent);
    border: 0.1rem solid color-mix(in oklch, var(--muted) 70%, transparent);
    padding: var(--spacing-3xs);
    backdrop-filter: blur(0.3rem);
    border-radius: var(--radius-sm);
  }
  .store-button {
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    nav {
      top: auto;
      bottom: var(--spacing-3xs);
      /*flex-wrap: wrap;*/
      /*flex-direction: row;*/
      gap: var(--spacing-3xs);
    }
    .leftBlock {
      flex-direction: column-reverse;
    }
    .navItemsWrapper {
      flex-wrap: wrap;
    }
  }
</style>
