---
import Input from "@/components/shared/Input.astro";
import ImagesDropzone from "@/components/dashboard/ImageDropzone.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Select from "@/components/shared/Select.astro";
import { getAllCategories } from "@/db/dashboard/categories/";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { getBrandsWithCollections } from "@/db/dashboard/brands";
import { getAllAttributesWithValues } from "@/db/dashboard/attributes";
import { actions, isInputError } from "astro:actions";
import type { ProductFormData } from "@/db/dashboard/products/index";
import { UNITS_OF_MEASUREMENT } from "@/lib/units";
import SelectListBox from "@/components/shared/SelectListBox.astro";
import MarkdownEditor from "./MarkdownEditor.astro";

interface Props {
  product?: ProductFormData;
}
const { product = {} } = Astro.props as Props;
const creating = !product.slug;

// TODO: load all in parallel with Promise.all()
// // const [categories, brandsWithCollections, attributesWithValues] =
//   await Promise.all([
//     getAllCategories(),
//     getBrandsWithCollections(),
//     getAllAttributesWithValues(),
//   ]);

const categories = await getAllCategories();
const categoryPolicies = Object.fromEntries(
  categories.map((category) => [
    String(category.id),
    category.hiddenAttributes ?? [],
  ]),
);
const selectedCategoryHiddenAttributes = new Set(
  categories.find((category) => category.id === product.categoryId)
    ?.hiddenAttributes ?? [],
);

const brandsWithCollections = await getBrandsWithCollections();
const collectionsByBrand = Object.fromEntries(
  brandsWithCollections.map((brand) => [
    String(brand.id),
    brand.collections.map((collection) => ({
      value: String(collection.id),
      label: collection.name,
    })),
  ]),
);

const attributesWithValues = await getAllAttributesWithValues();

const selectedUnitOfMeasurement = product.unitOfMeasurement
  ? String(product.unitOfMeasurement)
  : "м2";
const selectedCategoryId = product.categoryId ? String(product.categoryId) : "";
const selectedBrandId = product.brandId ? String(product.brandId) : "";
const selectedBrand = brandsWithCollections.find(
  (brand) => String(brand.id) === selectedBrandId,
);
const initialCollectionOptions =
  selectedBrand?.collections.map((collection) => ({
    value: String(collection.id),
    label: collection.name,
  })) ?? [];

const selectedCollectionId = product.collectionId
  ? String(product.collectionId)
  : "";

const images = product.images ?? [];

const updatedAtFormatter = new Intl.DateTimeFormat("ru-RU", {
  timeZone: "Asia/Vladivostok",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hourCycle: "h23",
  day: "numeric",
  month: "long",
  year: "numeric",
});

function formatTime(date?: Date | null) {
  if (!date) return "";

  const parts = Object.fromEntries(
    updatedAtFormatter
      .formatToParts(date)
      .map(({ type, value }) => [type, value]),
  );

  return `${parts.hour}:${parts.minute}:${parts.second}, ${parts.day} ${parts.month} ${parts.year}`;
}

const creationResult = Astro.getActionResult(actions.product.createProduct);
const updateResult = Astro.getActionResult(actions.product.updateProduct);

const creationError = creationResult?.error;
const updateError = updateResult?.error;
const formError =
  creationError && !isInputError(creationError)
    ? creationError.message
    : updateError && !isInputError(updateError)
      ? updateError.message
      : undefined;
const inputErrors =
  creationError && isInputError(creationError)
    ? creationError.fields
    : updateError && isInputError(updateError)
      ? updateError.fields
      : {};
---

<section class="pt-xl">
  <!--TODO: this is for files
    enctype="multipart/form-data" -->
  <!-- TODO: can the default html input validation be styled? -->
  <!-- TODO: should i toggle
  form.hasAttribute("data-busy")
considering that this is a native form? -->
  <form
    id="product-form"
    method="POST"
    data-mode={creating ? "create" : "edit"}
    data-category-policies={JSON.stringify(categoryPolicies)}
    data-collections-by-brand={JSON.stringify(collectionsByBrand)}
    action={creating
      ? actions.product.createProduct
      : actions.product.updateProduct}>
    {!creating && <input type="hidden" name="id" value={product.id} />}
    <div class="flex flex-row flex-wrap gap-xs items-center">
      <h1 class="text-lg pb-3xs">
        {creating ? "Создание товара" : "Редактирование товара"}
      </h1>
      {
        !creating && product.slug && (
          <Button size="sm" class="" href={`/product/${product.slug}`}>
            <Icon name="eye" title="Открыть в новой вкладке" />В магазине
          </Button>
        )
      }
    </div>
    {
      (
        <p id="form-error" role="alert" hidden={!formError}>
          {formError}
        </p>
      )
    }

    <div>
      <div class="images-and-general-wrapper">
        <ImagesDropzone images={images} />

        <fieldset>
          <legend>Общее</legend>

          <div class="formInputsBlock">
            <div class="inputRowWrapper">
              <Input
                name="name"
                label="Название"
                value={product.name}
                aria-describedby="error-name"
                required
                minlength="1"
                error={inputErrors.name}
                autofocus={creating ? true : false}
              />
              <!-- TODO: fix slug field being able to become focused on click, though it is set to readonly -->
              <Input
                name="slug"
                label="Ярлык"
                value={product.slug ? product.slug : ""}
                aria-describedby="error-slug"
                required
                minlength="1"
                error={inputErrors.slug}
                readonly={true}
              />
            </div>

            <div class="inputRowWrapper">
              <!-- TODO: add logic for the price to become not required if variations are present -->
              <Input
                name="price"
                label="Цена"
                value={product.price}
                aria-describedby="error-price"
                error={inputErrors.price}
                type="number"
              />
              <Input
                name="discountedPrice"
                label="Цена со скидкой"
                value={product.discountedPrice ?? ""}
                aria-describedby="error-discountedPrice"
                error={inputErrors.discountedPrice}
                type="number"
              />
            </div>

            <div class="inputRowWrapper">
              <Select
                name="categoryId"
                label="Категория"
                placeholder="Выбрать"
                value={selectedCategoryId}
                options={categories.map((category) => ({
                  value: String(category.id),
                  label: category.name,
                }))}
                required
                aria-describedby="error-categoryId"
                error={inputErrors.categoryId}
              />
              <Input
                name="sku"
                label="Артикул"
                value={product.sku}
                aria-describedby="error-sku"
                error={inputErrors.sku}
              />
            </div>
            <div class="inputRowWrapper">
              <Select
                name="brandId"
                label="Бренд"
                placeholder="Выбрать"
                value={selectedBrandId}
                options={brandsWithCollections.map((brand) => ({
                  value: String(brand.id),
                  label: brand.name,
                }))}
                aria-describedby="error-brandId"
                error={inputErrors.brandId}
              />
              <Select
                name="collectionId"
                label="Коллекция"
                placeholder={selectedBrandId
                  ? "Выбрать"
                  : "Сначала выберите бренд"}
                value={selectedCollectionId}
                options={initialCollectionOptions}
                disabled={!selectedBrandId}
                aria-describedby="error-collectionId"
                error={inputErrors.collectionId}
              />
            </div>
            <div class="inputRowWrapper">
              <Select
                name="unitOfMeasurement"
                label="Единица измерения"
                value={selectedUnitOfMeasurement}
                options={UNITS_OF_MEASUREMENT.map((unit) => ({
                  value: String(unit.id),
                  label: unit.value,
                }))}
                required
                aria-describedby="error-unitOfMeasurement"
                error={inputErrors.unitOfMeasurement}
              />
              <Input
                name="squareMetersPerPack"
                label="Площадь упаковки м²"
                value={product.squareMetersPerPack ?? null}
                aria-describedby="error-squareMetersPerPack"
                error={inputErrors.squareMetersPerPack}
                type="number"
                step=".001"
              />
            </div>
          </div>
          <div class="inputRowWrapper gap-x-md! gap-y-sm!">
            <fieldset class="inline-max">
              <legend class="text-base!">В наличии в магазинах</legend>
              <div class="flex flex-wrap shrink-0 gap-x-sm gap-y-2xs">
                {
                  STORE_LOCATIONS.map((location) => (
                    <Checkbox
                      name="storeLocationIds"
                      value={String(location.id)}
                      checked={
                        product.storeLocationIds?.includes(location.id) ?? false
                      }
                      aria-describedby="error-storeLocationIds">
                      {location.address}
                    </Checkbox>
                  ))
                }
              </div>
              <span
                id={`error-storeLocationIds`}
                role="alert"
                hidden={!inputErrors.storeLocationIds}>
                {inputErrors.storeLocationIds}
              </span>
            </fieldset>
            <Checkbox
              name="isActive"
              value="1"
              checked={product.isActive ?? true}>
              Товар активен
            </Checkbox>
          </div>
        </fieldset>
      </div>
      <div class="markdown-inputs-wrapper">
        <MarkdownEditor
          label="Важное примечание"
          name="importantNote"
          content={product.importantNote ?? ""}
          lessButtons
        />
        <MarkdownEditor
          label="Описание"
          name="description"
          content={product.description ?? ""}
        />
      </div>
      <div class="py-md">
        <Input
          as="textarea"
          name="dimensions"
          label="Габариты"
          value={product.dimensions ?? ""}
        />
      </div>
      <fieldset>
        <legend>Атрибуты</legend>
        <div class="flex flex-wrap gap-md">
          {
            attributesWithValues.map((attribute) => {
              const initiallyHidden = selectedCategoryHiddenAttributes.has(
                attribute.id,
              );
              return (
                <SelectListBox
                  id={`attribute-${attribute.id}`}
                  data-attribute-id={attribute.id}
                  name="attributeValueIds"
                  label={attribute.name}
                  value={product.attributeValueIds?.map(String) ?? []}
                  options={attribute.attributeValues.map((c) => ({
                    value: String(c.id),
                    label: c.name,
                  }))}
                  aria-describedby={"error-attribute-" + attribute.name}
                  hidden={initiallyHidden}
                  disabled={initiallyHidden}
                  error={inputErrors.attributeValueIds}
                />
              );
            })
          }
        </div>
      </fieldset>

      <fieldset>
        <!-- TODO: update all names, labels, errors, etc. for all variation fields -->
        <!-- TODO: fix the button to center the icon when the slot is empty -->
        <legend class="flex items-center gap-2xs"
          >Вариации <Button
            id="addVariationButton"
            size="sm"
            class="aspect-square"><Icon name="plus" title="Добавить" /></Button
          ></legend
        >
        <SelectListBox
          name="attributesForVariations"
          id="attributesForVariations"
          label="Отличительные атрибуты"
          options={attributesWithValues.map((attribute) => ({
            value: String(attribute.id),
            label: attribute.name,
          }))}
        />
        <div class="flex flex-wrap gap-md">
          <div id="listOfVariations"></div>
          <template id="variationEntry">
            <div class="inputRowWrapper variation">
              <div>
                <Input
                  name="squareMetersPerPack"
                  label="Площадь упаковки м²"
                  value={product.squareMetersPerPack ?? null}
                  aria-describedby="error-squareMetersPerPack"
                  error={inputErrors.squareMetersPerPack}
                  type="number"
                  step=".01"
                />
                <Button
                  class="aspect-square"
                  data-action="delete-variation"
                  variant="tertiary"><Icon name="x" title="Удалить" /></Button
                >
              </div>
              <div>
                <Input
                  name="price"
                  label="Цена"
                  value={product.price}
                  aria-describedby="error-price"
                  required
                  error={inputErrors.price}
                  type="number"
                />
                <Input
                  name="discountedPrice"
                  label="Цена со скидкой"
                  value={product.discountedPrice ?? ""}
                  aria-describedby="error-discountedPrice"
                  error={inputErrors.discountedPrice}
                  type="number"
                />
              </div>
            </div>
          </template>

          <template id="variation-attribute-template">
            <div class="variation-attribute" data-variation-attribute>
              <label data-attribute-label></label>

              <select data-attribute-select data-attribute-id></select>
            </div>
          </template>
        </div>
      </fieldset>
    </div>
    <div class="fixed bottom-2xs right-2xs flex gap-2xs">
      <Button id="submit-button" type="submit" disabled>
        <span class="submit-text"
          >{creating ? "Добавить" : "Нет изменений"}</span
        >
      </Button>
      {
        !creating && (
          <Button id="delete-button" variant="destructive">
            Удалить
          </Button>
        )
      }
    </div>
    <div>
      <p class="text-foreground-muted">
        Последнее изменение: <span class="text-inherit"
          >{formatTime(product.updatedAt)}</span
        >
      </p>
      <p class="text-foreground-muted">
        Создан: <span class="text-inherit">{formatTime(product.createdAt)}</span
        >
      </p>
    </div>
  </form>
</section>

<style>
  form {
    container-type: inline-size;
  }

  .images-and-general-wrapper {
    display: grid;
    grid-template-columns: 2fr 3fr;
    align-items: start;
    gap: var(--spacing-sm);
    @container (max-width: 60rem) {
      grid-template-columns: 1fr 1fr;
    }
    @container (max-width: 55rem) {
      grid-template-columns: 1fr;
    }
  }

  .markdown-inputs-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: var(--spacing-sm);

    @container (max-width: 55rem) {
      grid-template-columns: 1fr;
    }
  }

  .variation {
    border: var(--border-width) solid var(--muted);
    padding: var(--spacing-2xs);
    border-radius: var(--radius-md);
  }
</style>

<script src="@/scripts/productHandling"></script>

<!-- TODO: for data-category-policies and data-collections-by-brandfor instead use a compact JSON script block.  -->
<script src="@/scripts/variationHandling.ts"></script>
