---
import Input from "@/components/shared/Input.astro";
import ImagesDropzone from "@/components/dashboard/ImageDropzone.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Select from "@/components/shared/Select.astro";
import { getAllCategories } from "@/db/dashboard/categories/";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { getBrandsWithCollections } from "@/db/dashboard/brands";
import { getAllAttributesWithValues } from "@/db/dashboard/attributes";
import { actions, isInputError } from "astro:actions";
import MarkdownEditor from "./MarkdownEditor.astro";
import type { FormProduct } from "@/db/dashboard/products/index";
import { UNITS_OF_MEASUREMENT } from "@/lib/units";
import { COUNTRIES } from "@/lib/countries";

interface Props {
  product?: FormProduct;
}
const { product = {} } = Astro.props as Props;
const creating = !product.slug;
const categories = await getAllCategories();
const brandsWithCollections = await getBrandsWithCollections();

const attributesWithValues = await getAllAttributesWithValues();

const selectedUnitOfMeasurement = product.unitOfMeasurement
  ? String(product.unitOfMeasurement)
  : "м2";
const selectedCategoryId = product.categoryId ? String(product.categoryId) : "";
const selectedBrandId = product.brandId ? String(product.brandId) : "";
const selectedCollectionId = product.collectionId
  ? String(product.collectionId)
  : "";

const images = product.images ?? [];

const updatedAtFormatter = new Intl.DateTimeFormat("ru-RU", {
  timeZone: "Asia/Vladivostok",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hourCycle: "h23",
  day: "numeric",
  month: "long",
  year: "numeric",
});

function formatTime(date?: Date | null) {
  if (!date) return "";

  const parts = Object.fromEntries(
    updatedAtFormatter
      .formatToParts(date)
      .map(({ type, value }) => [type, value]),
  );

  return `${parts.hour}:${parts.minute}:${parts.second}, ${parts.day} ${parts.month} ${parts.year}`;
}

const creationResult = Astro.getActionResult(actions.product.createProduct);
const updateResult = Astro.getActionResult(actions.product.updateProduct);

const inputErrors = isInputError(creationResult?.error)
  ? creationResult.error.fields
  : isInputError(updateResult?.error)
    ? updateResult.error.fields
    : {};
---

<section class="pt-xl">
  <!--TODO: this is for files
    enctype="multipart/form-data" -->
  <!-- TODO: can the default html input validation be styled? -->
  <!-- TODO: should i toggle
  form.hasAttribute("data-busy")
considering that this is a native form? -->
  <form
    id="product-form"
    method="POST"
    data-mode={creating ? "create" : "edit"}
    action={creating
      ? actions.product.createProduct
      : actions.product.updateProduct}>
    {!creating && <input type="hidden" name="id" value={product.id} />}
    <h1 class="text-lg pb-2">
      {creating ? "Создание товара" : "Редактирование товара"}

      {
        (
          <p
            id="form-error"
            role="alert"
            hidden={!creationResult?.error && !updateResult?.error}>
            {creationResult?.error
              ? "Ошибка создания товара"
              : updateResult?.error
                ? "Ошибка обновления товара"
                : ""}
          </p>
        )
      }
      {
        !creating && product.slug && (
          <Button
            size="sm"
            class="inline-block align-baseline ml-xs"
            href={`/product/${product.slug}`}>
            <Icon name="eye" title="Открыть в новой вкладке" class="size-5" />В
            магазине
          </Button>
        )
      }
    </h1>
    <div class="formWrapper">
      <ImagesDropzone images={images} />

      <fieldset>
        <legend>Общее</legend>

        <div class="formInputsBlock">
          <div class="inputRowWrapper">
            <Input
              name="name"
              label="Название"
              value={product.name}
              aria-describedby="error-name"
              required
              minlength="1"
              error={inputErrors.name}
              autofocus
            />
            <!-- TODO: fix slug field being able to become focused on click, though it is set to readonly -->
            <Input
              name="slug"
              label="Ярлык"
              value={product.slug ? product.slug : ""}
              aria-describedby="error-slug"
              required
              minlength="1"
              error={inputErrors.slug}
              readonly={true}
            />
          </div>

          <div class="inputRowWrapper">
            <!-- TODO: add logic for the price to become not required if variations are present -->
            <Input
              name="price"
              label="Цена"
              value={product.price}
              aria-describedby="error-price"
              required
              error={inputErrors.price}
            />
            <Input
              name="discountedPrice"
              label="Цена со скидкой"
              value={product.discountedPrice ?? ""}
              aria-describedby="error-discountedPrice"
              error={inputErrors.discountedPrice}
            />
          </div>

          <div class="inputRowWrapper">
            <Select
              name="categoryId"
              label="Категория"
              placeholder="Выбрать"
              value={selectedCategoryId}
              options={categories.map((category) => ({
                value: String(category.id),
                label: category.name,
              }))}
              required
              aria-describedby="error-categoryId"
              error={inputErrors.categoryId}
            />
            <Input
              name="sku"
              label="Артикул"
              value={product.sku}
              aria-describedby="error-sku"
              error={inputErrors.sku}
            />
          </div>
          <div class="inputRowWrapper">
            <Select
              name="brandId"
              label="Бренд"
              placeholder="Выбрать"
              value={selectedBrandId}
              options={brandsWithCollections.map((brand) => ({
                value: String(brand.id),
                label: brand.name,
              }))}
              aria-describedby="error-brandId"
              error={inputErrors.brandId}
            />
            <Select
              name="collectionId"
              label="Коллекция"
              placeholder="Выбрать"
              value={selectedCollectionId}
              options={[]}
              aria-describedby="error-collectionId"
              error={inputErrors.collectionId}
            />
          </div>
          <div class="inputRowWrapper">
            <Select
              name="unitOfMeasurement"
              label="Единица измерения"
              value={selectedUnitOfMeasurement}
              options={UNITS_OF_MEASUREMENT.map((unit) => ({
                value: String(unit.id),
                label: unit.value,
              }))}
              required
              aria-describedby="error-unitOfMeasurement"
              error={inputErrors.unitOfMeasurement}
            />
            <Input
              name="squareMetersPerPack"
              label="Площадь упаковки м²"
              value={product.squareMetersPerPack ?? null}
              aria-describedby="error-squareMetersPerPack"
              error={inputErrors.squareMetersPerPack}
            />
            <Select
              name="country"
              label="Страна"
              value={product.country?.toString() ?? null}
              options={COUNTRIES.map((c) => ({
                value: String(c.id),
                label: c.name,
              }))}
              aria-describedby="error-country"
              error={inputErrors.country}
            />
          </div>
        </div>
        <div class="inputRowWrapper gap-x-md! gap-y-sm!">
          <fieldset class="inline-max">
            <legend class="text-base!">В наличии в магазинах</legend>
            <div class="flex flex-wrap shrink-0 gap-x-sm gap-y-2xs">
              {
                STORE_LOCATIONS.map((location) => (
                  <Checkbox
                    name="storeLocationIds"
                    value={String(location.id)}
                    checked={
                      product.storeLocationIds?.includes(location.id) ?? false
                    }
                    aria-describedby="error-storeLocationIds">
                    {location.address}
                  </Checkbox>
                ))
              }
            </div>
            <span
              id={`error-storeLocationIds`}
              role="alert"
              hidden={!inputErrors.storeLocationIds}>
              {inputErrors.storeLocationIds}
            </span>
          </fieldset>
          <Checkbox
            name="isActive"
            value="1"
            checked={product.isActive ?? true}>
            Товар активен
          </Checkbox>
        </div>

        <!-- TODO: re-do markdown editor from the ground up -->
        <!-- <MarkdownEditor
          label="Важное примечание"
          name="importantNote"
          content={product.importantNote ?? ""}
          lessButtons
        />
        <MarkdownEditor
          label="Описание"
          name="description"
          content={product.description ?? ""}
        /> -->
      </fieldset>

      <!-- <h4 class="text-md">Атрибуты</h4> -->
      <fieldset>
        <legend>Атрибуты</legend>
        <div class="autoGrid">
          {
            attributesWithValues.map((attribute) => (
              <div>
                <h6>{attribute.name}</h6>
                <div class="grid">
                  {attribute.attributeValues.map((value) => (
                    <Checkbox name={attribute.name + " " + value.name}>
                      {value.name}
                    </Checkbox>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </fieldset>
    </div>
    <div class="fixed bottom-2xs right-2xs flex gap-2xs">
      <Button size="lg" id="submit-button" type="submit" disabled>
        <span class="submit-text"
          >{creating ? "Добавить" : "Нет изменений"}</span
        >
      </Button>
      {
        !creating && (
          <Button size="lg" id="delete-button" variant="destructive">
            Удалить
          </Button>
        )
      }
    </div>
    <p class="text-foreground-muted">
      Последнее изменение: <span class="text-inherit"
        >{formatTime(product.updatedAt)}</span
      >
    </p>
    <p class="text-foreground-muted">
      Создан: <span class="text-inherit">{formatTime(product.createdAt)}</span>
    </p>
  </form>
</section>

<style>
  form {
    container-type: inline-size;
  }
  .formWrapper {
    display: grid;
    grid-template-columns: 2fr 3fr;
    align-items: start;
    gap: var(--spacing-sm);
    @container (max-width: 60rem) {
      grid-template-columns: 1fr 1fr;
    }
    @container (max-width: 55rem) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { generateSlug } from "@/lib/slugGeneration";
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";

  const productForm = document.querySelector<HTMLFormElement>(
    "#product-form",
  ) as HTMLFormElement;

  const submitButton =
    productForm.querySelector<HTMLButtonElement>("#submit-button");

  const mode = productForm.dataset.mode;
  let mediaBlocked = false;

  function getFormState() {
    //TODO: This has several edge cases:
    // - checkbox order matters;
    // - missing unchecked values differ from explicit false values;
    // - empty select values may differ from null;
    // - whitespace differences count as changes even if the server trims them;
    // - generated slug changes are treated as changes;
    // - future file fields are represented only by filename, not file contents;
    // - field order changes can produce false differences.
    // Recommended solution:
    // - Normalize fields into a typed form-state object.
    // - Normalize numeric empty values to null.
    // - Represent checkboxes explicitly as booleans or sorted arrays.
    // - Compare semantic values rather than raw FormData.
    return JSON.stringify(
      [...new FormData(productForm).entries()].map(([key, value]) => [
        key,
        value instanceof File ? value.name : value,
      ]),
    );
  }

  const initialFormState = getFormState();

  function updateSubmitButton() {
    if (!submitButton) return;

    const unchanged = getFormState() === initialFormState;
    submitButton.disabled = unchanged || mediaBlocked;
    submitButton.title = mediaBlocked
      ? "Дождитесь завершения загрузки или удалите фото с ошибкой"
      : "";
    const submitText = submitButton.querySelector(".submit-text");
    if (submitText) {
      submitText.textContent =
        mode === "edit"
          ? unchanged && !mediaBlocked
            ? "Нет изменений"
            : "Сохранить"
          : "Добавить";
    }
  }

  // Auto-generate slug from name
  const nameInput =
    productForm.querySelector<HTMLInputElement>('[name="name"]');
  const slugInput =
    productForm.querySelector<HTMLInputElement>('[name="slug"]');

  function updateSlug() {
    if (!nameInput || !slugInput) return;
    slugInput.value = generateSlug(nameInput.value);
  }

  nameInput?.addEventListener("input", updateSlug);

  import { PRODUCT_FORM_DRAFT_PREFIX } from "@/lib/formDrafts";
  const formStorageKey = `${PRODUCT_FORM_DRAFT_PREFIX}${location.pathname}`;
  let draftPersistenceWarningShown = false;

  function trySaveDraft(key: string, state: Record<string, string[]>) {
    try {
      window.sessionStorage.setItem(key, JSON.stringify(state));
      return true;
    } catch (error) {
      if (!draftPersistenceWarningShown) {
        console.warn("Product form draft persistence is unavailable", error);
        draftPersistenceWarningShown = true;
      }
    }
  }
  function saveDraft() {
    const state: Record<string, string[]> = {};
    for (const [name, value] of new FormData(productForm)) {
      // Files cannot be restored from sessionStorage.
      if (typeof value !== "string") continue;

      state[name] ??= [];
      state[name].push(value);
    }
    trySaveDraft(formStorageKey, state);
  }

  let saveTimer: number | undefined;
  function scheduleDraftSave() {
    window.clearTimeout(saveTimer);

    saveTimer = window.setTimeout(() => {
      saveDraft();
    }, 400);
  }
  function flushDraftSave() {
    window.clearTimeout(saveTimer);
    saveTimer = undefined;
    saveDraft();
  }
  function readDraft(key: string): Record<string, string[]> | null {
    let rawState: string | null;

    try {
      rawState = window.sessionStorage.getItem(key);
    } catch (error) {
      console.warn("Unable to read product form draft", error);
      return null;
    }

    if (!rawState) return null;

    try {
      const parsed: unknown = JSON.parse(rawState);

      if (
        typeof parsed !== "object" ||
        parsed === null ||
        Array.isArray(parsed)
      ) {
        return null;
      }

      const state: Record<string, string[]> = {};

      for (const [key, value] of Object.entries(parsed)) {
        if (
          !Array.isArray(value) ||
          !value.every((item) => typeof item === "string")
        ) {
          return null;
        }

        state[key] = value;
      }

      return state;
    } catch (error) {
      console.warn("Unable to parse product form draft", error);
      return null;
    }
  }
  function restoreDraft() {
    const state = readDraft(formStorageKey);

    if (!state) return;

    for (const element of Array.from(productForm.elements)) {
      if (!(
        element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement ||
        element instanceof HTMLSelectElement
      )) {
        continue;
      }

      if (!element.name) continue;

      const values = state[element.name] ?? [];

      if (
        element instanceof HTMLInputElement &&
        (element.type === "checkbox" || element.type === "radio")
      ) {
        element.checked = values.includes(element.value);
      } else if (element instanceof HTMLSelectElement && element.multiple) {
        for (const option of Array.from(element.options)) {
          option.selected = values.includes(option.value);
        }
      } else if (
        element instanceof HTMLInputElement &&
        ["submit", "button", "reset", "file"].includes(element.type)
      ) {
        continue;
      } else {
        element.value = values[0] ?? "";
      }
    }

    updateSlug();
    updateSubmitButton();
  }

  productForm.addEventListener("input", () => {
    updateSubmitButton();
    scheduleDraftSave();
  });
  productForm.addEventListener("change", () => {
    updateSubmitButton();
    scheduleDraftSave();
  });
  productForm.addEventListener("media-state-change", (event) => {
    const state = (
      event as CustomEvent<{ uploading: boolean; hasError: boolean }>
    ).detail;
    mediaBlocked = state.uploading || state.hasError;
    updateSubmitButton();
  });
  window.addEventListener("pageshow", restoreDraft);

  //event listeners
  productForm.addEventListener("submit", async (event) => {
    if (!submitButton || submitButton.disabled) {
      event.preventDefault();
      return;
    }
    flushDraftSave();
    submitButton.setAttribute("disabled", "");
    submitButton.setAttribute("aria-busy", "true");
  });

  //TODO: like in submit button this should get spinner
  const deleteButton = document.querySelector<HTMLButtonElement>(
    "#delete-button",
  ) as HTMLButtonElement;
  if (deleteButton) {
    deleteButton.addEventListener("click", async () => {
      const formData = new FormData(productForm) as FormData;
      const name = formData.get("name") as string;
      if (!confirm(`Удалить товар ${name}?`)) {
        return;
      }

      try {
        deleteButton.disabled = true;
        deleteButton.setAttribute("aria-busy", "true");
        const { error } = await actions.product.deleteProduct(formData);
        if (error) {
          confirm("Произошла ошибка при удалении");
          throw new Error("Произошла ошибка при удалении");
        } else {
          navigate("/dashboard");
        }
      } catch (error) {
        console.log(error);
        deleteButton.disabled = false;
        deleteButton.setAttribute("aria-busy", "false");
      }
    });
  }
</script>
