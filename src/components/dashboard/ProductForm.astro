---
import Input from "@/components/shared/Input.astro";
import Button from "@/components/shared/Button.astro";
import Select from "@/components/shared/Select.astro";
import { getAllCategories } from "@/db/storefront/allCategories";
import ImageDropzone from "@/components/dashboard/ImageDropzone.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
type ProductFormProduct = {
    id?: number;
    slug?: string;
    name?: string;
    images?: string[];
    price?: number | null;
    discountedPrice?: number | null;
    categoryId?: number;
    description?: string | null;
    importantNote?: string | null;
    isActive?: boolean;
    isFeatured?: boolean;
};

interface Props {
    product?: ProductFormProduct;
}

const { product = {} } = Astro.props as Props;
const images: string[] = product.images ?? [];

const categories = await getAllCategories();

const creating = product.slug ? false : true;
---

<form
    id="product-form"
    method="POST"
    class="max-w-[80ch] mx-auto py-14"
    data-mode={creating ? "create" : "edit"}
>
    <h1 class="text-md pb-2">
        {creating ? "Добавление товара" : "Редактирование товара"}
    </h1>
    {!creating && <input type="hidden" name="id" value={product.id} />}

    <div class="productForm">
        <div>
            <ImageDropzone images={images} />
            <!-- <Button
                ><input
                    type="file"
                    id="photos"
                    name="photos"
                    accept="image/png, image/jpeg, image/webp"
                /></Button
            > -->
        </div>
        <div class="grid grid-cols-2 gap-x-2">
            <Input name="name" label="Название" value={product.name} required />
            <Input
                name="slug"
                label="Ярлык"
                value={product.slug ? product.slug : ""}
                readonly={true}
                required
            />
            <Input name="price" label="Цена" value={product.price} required />
            <Input
                name="discountedPrice"
                label="Цена со скидкой"
                value={product.discountedPrice}
            />
        </div>
        <Select
            name="categoryId"
            label="Категория"
            options={categories}
            selectedOption={product.categoryId}
            required
        />
        <Input
            as="textarea"
            name="description"
            label="Описание"
            value={product.description}
            rows={4}
        />
        <Input
            as="textarea"
            name="importantNote"
            label="Важная заметка"
            value={product.importantNote}
            rows={4}
        />
        <div class="flex flex-wrap gap-4">
            <Checkbox
                name="isActive"
                label="Активен"
                checked={creating
                    ? true
                    : product.isActive
                      ? product.isActive
                      : false}
            />
            <Checkbox
                name="isFeatured"
                label="Рекомендуемый"
                checked={product.isFeatured ? product.isFeatured : false}
            />
        </div>
    </div>
    <Button type="submit">{creating ? "Добавить" : "Сохранить"}</Button>
    <Button variant="destructive">Удалить</Button>
</form>

<script>
    import { actions } from "astro:actions";
    import { generateSlug } from "@/lib/slugGeneration";

    const form = document.querySelector<HTMLFormElement>("#product-form");
    if (!form) throw Error("Форма не найдена");
    const mode = form.dataset.mode;

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(e.currentTarget as HTMLFormElement);
            const { data, error } =
                mode === "edit"
                    ? await actions.product.updateProduct(formData)
                    : await actions.product.createProduct(formData);

            if (error) {
                alert(error);
            } else {
                alert(data);
            }
        });

        const nameInput = form.querySelector<HTMLInputElement>('[name="name"]');
        const slugInput = form.querySelector<HTMLInputElement>('[name="slug"]');

        if (nameInput && slugInput) {
            nameInput.addEventListener("input", () => {
                slugInput.value = generateSlug(nameInput.value);
            });
        }
    }
</script>

<style>
    .productForm {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;

        margin: auto;
    }
</style>
