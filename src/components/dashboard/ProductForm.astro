---
import Input from "@/components/shared/Input.astro";
import ImagesDropzone from "@/components/dashboard/ImageDropzone.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";
import Checkbox from "@/components/shared/Checkbox.astro";
import Select from "@/components/shared/Select.astro";
import { getAllCategories } from "@/db/dashboard/categories/";

type FormProduct = {
  id?: number;
  slug?: string;
  name?: string;
  isActive?: boolean;
  categoryId?: number;
  price?: number;
  discountedPrice?: number | null;
  images?: string | null;
};
interface Props {
  product?: FormProduct;
}
const { product = {} } = Astro.props as Props;
const creating = !product.slug;
const categories = await getAllCategories();
const selectedCategoryId = product.categoryId ? String(product.categoryId) : "";
const images = product.images ?? [];
---

<section class="pt-xl">
  <form
    novalidate
    id="product-form"
    method="POST"
    data-mode={creating ? "create" : "edit"}>
    {!creating && <input type="hidden" name="id" value={product.id} />}
    <h1 class="text-lg pb-2">
      {creating ? "Создание товара" : "Редактирование товара"}
      {
        !creating && product.slug && (
          <Button
            size="sm"
            withIcon
            class="inline-block align-baseline ml-xs"
            href={`/store/${product.slug}`}>
            <Icon name="eye" title="Открыть в новой вкладке" class="size-5" />В
            магазине
          </Button>
        )
      }
    </h1>

    <ImagesDropzone images={images} />

    <div class="textInputFields">
      <div class="nameSlug">
        <Input
          name="name"
          label="Название"
          value={product.name}
          required
          autofocus
          autocomplete="off"
        />
        <Input
          name="slug"
          label="Ярлык"
          value={product.slug ? product.slug : ""}
          readonly={true}
          required
        />
      </div>

      <div class="nameSlug">
        <Input
          name="price"
          label="Цена"
          value={product.price}
          required
          autocomplete="off"
        />
        <Input
          name="discountedPrice"
          label="Цена со скидкой"
          value={product.discountedPrice ? product.discountedPrice : ""}
          autocomplete="off"
        />
      </div>

      <div class="categoryActiveInputs">
        <Select
          name="categoryId"
          label="Категория"
          placeholder="Выбрать"
          value={selectedCategoryId}
          options={categories.map((category) => ({
            value: String(category.id),
            label: category.name,
          }))}
          required
        />
        <Checkbox
          name="isActive"
          value="1"
          checked={product.isActive ?? true}>
          Товар активен
        </Checkbox>
      </div>
    </div>
    <Button id="submit-btn" size="sm" type="submit">
      <span class="submit-text">{creating ? "Добавить" : "Сохранить"}</span>
      <Icon name="spinner" class="submit-spinner size-5 animate-spin" />
    </Button>
    {
      !creating && (
        <Button
          id="delete-button"
          size="sm"
          variant="destructive"
          type="button">
          Удалить
        </Button>
      )
    }
  </form>
</section>

<style>
  form {
    margin: auto;
    padding-bottom: 4rem;
    container-type: inline-size;
    max-width: 80ch;
  }
  .textInputFields {
    display: grid;
    gap: var(--spacing-2xs);
    container-type: inline-size;
  }
  .nameSlug {
    display: grid;
    gap: var(--spacing-2xs);
    grid-template-columns: 1fr;
    @container (min-width: 60ch) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .categoryActiveInputs {
    display: grid;
    gap: var(--spacing-2xs);
    grid-template-columns: 1fr;
    @container (min-width: 37ch) {
      grid-template-columns: 1fr 1fr;
      justify-items: center;
    }</style>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { generateSlug } from "@/lib/slugGeneration";

  const productForm = document.querySelector<HTMLFormElement>(
    "#product-form",
  ) as HTMLFormElement;

  const mode = productForm.dataset.mode;

  // Auto-generate slug from name
  const nameInput =
    productForm.querySelector<HTMLInputElement>('[name="name"]');
  const slugInput =
    productForm.querySelector<HTMLInputElement>('[name="slug"]');
  if (nameInput && slugInput) {
    nameInput.addEventListener("input", () => {
      slugInput.value = generateSlug(nameInput.value);
    });
  }

  //event listeners
  productForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(productForm) as FormData;
    if (productForm.hasAttribute("disabled")) {
      return;
    }

    try {
      productForm.setAttribute("disabled", "true");
      const { data, error } =
        mode === "edit"
          ? await actions.product.updateProduct(formData)
          : await actions.product.createProduct(formData);
      if (error) {
        throw new Error("Unable to submit the form");
      } else {
        navigate("/dashboard");
      }
    } catch (error) {
      console.log(error);
      productForm.removeAttribute("disabled");
    }
  });

  const deleteButton = document.querySelector<HTMLButtonElement>(
    "#delete-button",
  ) as HTMLButtonElement;
  if (deleteButton) {
    deleteButton.addEventListener("click", async () => {
      const formData = new FormData(productForm) as FormData;
      const name = formData.get("name") as string;
      if (!confirm(`Удалить товар ${name}?`)) {
        return;
      }

      try {
        productForm.setAttribute("disabled", "true");
        const { data, error } = await actions.product.deleteProduct(formData);
        if (error) {
          throw new Error("Произошла ошибка при удалении");
        } else {
          navigate("/dashboard");
        }
      } catch (error) {
        console.log(error);
        productForm.removeAttribute("disabled");
      }
    });
  }
</script>
