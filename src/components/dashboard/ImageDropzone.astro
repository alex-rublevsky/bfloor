---
// the old setup is:
// _ImageTile.astro
// _dropzone-gallery.ts
// _storage.ts
// _update-media.ts
// _upload-url.ts
// _delete-media.ts

import { BASE_IMAGE_URL } from "@/constants";
import { Image } from "astro:assets";
// import ImageTile from "@/components/dashboard/ImageTile.astro";

const { images } = Astro.props;
---

<div>
  <div class="images">
    {
      images.map((image: string) => (
        <div>
          <Image
            src={`${BASE_IMAGE_URL}${image}`}
            alt=""
            width={100}
            height={100}
          />
          <p class="text-2xs">{image}</p>
        </div>
      ))
    }
  </div>
  <label>Фотки можно перетащить сюда</label>
</div>

<style>
  .images {
    gap: var(--spacing-3xs);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }
</style>
