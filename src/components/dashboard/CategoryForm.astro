---
import Input from "@/components/shared/Input.astro";
// import ImagesDropzone from "@/components/dashboard/ImageDropzone.astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/shared/Button.astro";

type FormCategory = {
  id?: number;
  slug?: string;
  name?: string;
  // image?: string | null;
};
interface Props {
  category?: FormCategory;
}
const { category = {} } = Astro.props as Props;
const creating = !category.slug;
// const image = category.image ?? "";
---

<section class="pt-xl">
  <form
    novalidate
    id="category-form"
    method="POST"
    data-mode={creating ? "create" : "edit"}>
    {!creating && <input type="hidden" name="id" value={category.id} />}
    <h1 class="text-lg pb-2">
      {creating ? "Создание категории" : "Редактирование категории"}
      {
        !creating && category.slug && (
          <Button
            size="sm"
            withIcon
            class="inline-block align-baseline ml-xs"
            href={`/store/${category.slug}`}>
            <Icon name="eye" title="Открыть в новой вкладке" class="size-5" />В
            магазине
          </Button>
        )
      }
    </h1>

    <!-- <ImagesDropzone images={images} /> -->

    <div class="textInputFields">
      <div class="nameSlug">
        <Input
          name="name"
          label="Название"
          value={category.name}
          required
          autofocus
          autocomplete="off"
        />
        <Input
          name="slug"
          label="Ярлык"
          value={category.slug ? category.slug : ""}
          readonly={true}
          required
        />
      </div>
    </div>
    <Button id="submit-btn" size="sm" type="submit">
      <span class="submit-text">{creating ? "Добавить" : "Сохранить"}</span>
      <Icon name="spinner" class="submit-spinner size-5 animate-spin" />
    </Button>
    {
      !creating && (
        <Button
          id="delete-button"
          size="sm"
          variant="destructive"
          type="button">
          Удалить
        </Button>
      )
    }
  </form>
</section>

<style>
  form {
    margin: auto;
    padding-bottom: 4rem;
    container-type: inline-size;
    max-width: 80ch;
  }
  .textInputFields {
    display: grid;
    gap: var(--spacing-2xs);
    container-type: inline-size;
  }
  .nameSlug {
    display: grid;
    gap: var(--spacing-2xs);
    grid-template-columns: 1fr;
    @container (min-width: 60ch) {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { generateSlug } from "@/lib/slugGeneration";

  const categoryForm = document.querySelector<HTMLFormElement>(
    "#category-form",
  ) as HTMLFormElement;

  const mode = categoryForm.dataset.mode;

  // Auto-generate slug from name
  const nameInput =
    categoryForm.querySelector<HTMLInputElement>('[name="name"]');
  const slugInput =
    categoryForm.querySelector<HTMLInputElement>('[name="slug"]');
  if (nameInput && slugInput) {
    nameInput.addEventListener("input", () => {
      slugInput.value = generateSlug(nameInput.value);
    });
  }

  //event listeners
  categoryForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(categoryForm) as FormData;
    if (categoryForm.hasAttribute("disabled")) {
      return;
    }

    try {
      categoryForm.setAttribute("disabled", "true");
      const { data, error } =
        mode === "edit"
          ? await actions.category.updateCategory(formData)
          : await actions.category.createCategory(formData);
      if (error) {
        throw new Error("Unable to submit the form");
      } else {
        navigate("/dashboard/categories");
      }
    } catch (error) {
      console.log(error);
      categoryForm.removeAttribute("disabled");
    }
  });

  const deleteButton = document.querySelector<HTMLButtonElement>(
    "#delete-button",
  ) as HTMLButtonElement;
  if (deleteButton) {
    deleteButton.addEventListener("click", async () => {
      const formData = new FormData(categoryForm) as FormData;
      const name = formData.get("name") as string;
      if (!confirm(`Удалить категорию ${name}?`)) {
        return;
      }

      try {
        categoryForm.setAttribute("disabled", "true");
        const { data, error } = await actions.category.deleteCategory(formData);
        if (error) {
          throw new Error("Произошла ошибка при удалении");
        } else {
          navigate("/dashboard/categories");
        }
      } catch (error) {
        console.log(error);
        categoryForm.removeAttribute("disabled");
      }
    });
  }
</script>
