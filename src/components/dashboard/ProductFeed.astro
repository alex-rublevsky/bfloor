---
import { getAllProductsByCategory } from "@/db/dashboard/products/allProductsByCategory";
import DashboardProductCard from "@/components/dashboard/DashboardProductCard.astro";

interface Props {
  categoryId: number;
}
const { categoryId } = Astro.props;

const page = 1;
const products = await getAllProductsByCategory(categoryId, page);
---

<>
  {
    products && products.length > 0 ? (
      <section class="autoGrid">
        <h1 class="sr-only">Товары</h1>
        {products.map((product) => (
          <DashboardProductCard product={product} />
        ))}
      </section>
    ) : (
      <section class="h-screen grid place-items-center">
        <h1 class="text-lg!">Товаров не найдено</h1>
      </section>
    )
  }
</>
