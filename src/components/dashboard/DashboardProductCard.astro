---
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";
import type { Product } from "@/db/schema";
import ImagePlaceholder from "../shared/ImagePlaceholder.astro";
import Checkbox from "../shared/Checkbox.astro";
import { getUnitOfMeasurement } from "@/lib/units";

// type Props = { product?: Product };

const { product } = Astro.props;

if (!product) {
  return null;
}

const { images } = product;
const unitOfMeasurement =
  getUnitOfMeasurement(product.unitOfMeasurement)?.value ??
  product.unitOfMeasurement;
---

<article class="product-card">
  <Checkbox name="products" value={product.id} />
  <a href={`/dashboard/product/${product.slug}`}>
    <div class="entityImageWrapper">
      <div class="selectLabel"></div>
      <div class="entityImage">
        {
          images ? (
            <Image
              src={BASE_IMAGE_URL + images[0]}
              width={500}
              height={500}
              alt={product.name}
              loading="lazy"
              class="skeleton object-cover mix-blend-darken"
              onload="this.closest('.skeleton')?.classList.remove('skeleton')"
            />
          ) : (
            <ImagePlaceholder />
          )
        }
      </div>
    </div>
    <div id="productPrices">
      {
        product.discountedPrice ? (
          <>
            {product.hasVariations ? <span>от </span> : undefined}
            <span class="price">{product.discountedPrice}</span>
            {unitOfMeasurement ? (
              <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
            ) : null}
          </>
        ) : null
      }
      {product.hasVariations ? <span>от </span> : undefined}
      <span class={product.discountedPrice ? "discountedPrice" : "price"}
        >{product.price}</span
      >

      {
        !product.discountedPrice && unitOfMeasurement ? (
          <span class="currencyAndUnit">р/{unitOfMeasurement}</span>
        ) : null
      }
    </div>
    <p class="text-sm">{product.name}</p>
  </a>
</article>
<style>
  .product-card {
    position: relative;
    transition: transform 70ms ease-out;
  }

  /*without this the checkbox would be left out*/
  .product-card:has(> a:active) {
    transform: scale(0.97);
  }

  .product-card > a:active {
    transform: none;
  }

  a {
    height: 100%;
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background-color: var(--accent);
      border: var(--border-width-thick) solid var(--accent);
      opacity: 0;
      pointer-events: none;
      transition: opacity 150ms ease;
    }
  }

  .product-card > :global(.checkbox-wrapper) {
    position: absolute;
    inset: var(--spacing-2xs) auto auto var(--spacing-2xs);
    z-index: 10;
    visibility: hidden;
    & input[type="checkbox"] {
      width: var(--text-md);
      height: var(--text-md);
    }
  }

  .product-card:hover > :global(.checkbox-wrapper),
  .product-card:focus-within > :global(.checkbox-wrapper) {
    visibility: visible;
  }

  .entityImageWrapper {
    display: grid;
    place-items: center;
  }

  .entityImage,
  .selectLabel {
    grid-area: 1/1;
  }

  .selectLabel {
    visibility: hidden;
    z-index: 10;
    pointer-events: none;
    background-color: var(--accent);
    backdrop-filter: blur(4px);
    color: var(--background);
    padding-block: var(--spacing-3xs);
    padding-inline: var(--spacing-2xs);
    border-radius: var(--radius-sm);
    width: fit-content;
    height: fit-content;
  }

  .showSelectLabelOnHover:hover .selectLabel {
    visibility: visible;
  }

  .showSelectLabelOnHover:hover a::after {
    opacity: 0.15;
  }
</style>
