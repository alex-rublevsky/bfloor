---
import { Image } from "astro:assets";
import { BASE_IMAGE_URL } from "@/constants";
import type { Product } from "@/db/schema";
import ImagePlaceholder from "../shared/ImagePlaceholder.astro";
import Checkbox from "../shared/Checkbox.astro";

// type Props = { product?: Product };

const { product } = Astro.props;

if (!product) {
  return null;
}

const { images } = product;
---

<article class="product-card">
  <Checkbox name="products" value={product.id} />
  <a href={`/dashboard/product/${product.slug}`}>
    <div class="entityImageWrapper">
      <div class="entityImage">
        {
          images ? (
            <Image
              src={BASE_IMAGE_URL + images[0]}
              width={500}
              height={500}
              alt={product.name}
              loading="lazy"
              class="skeleton object-cover mix-blend-darken"
              onload="this.closest('.skeleton')?.classList.remove('skeleton')"
            />
          ) : (
            <ImagePlaceholder />
          )
        }
      </div>
    </div>
    <div class="flex gap-2xs">
      {
        product.discountedPrice ? (
          <p>
            {product.hasVariations ? "от " : ""}
            {product.discountedPrice}Р
          </p>
        ) : null
      }
      <p
        class={`${product.discountedPrice ? "line-through text-foreground-muted" : undefined}`}>
        {product.hasVariations ? "от " : ""}{product.price}Р
      </p>
    </div>
    <p class="text-sm">{product.name}</p>
  </a>
</article>
<style>
  .product-card {
    position: relative;
  }

  .product-card > :global(.checkbox-wrapper) {
    position: absolute;
    inset: var(--spacing-2xs) auto auto var(--spacing-2xs);
    z-index: 10;
    visibility: hidden;
    & input[type="checkbox"] {
      width: var(--text-md);
      height: var(--text-md);
    }
  }

  .product-card:hover > :global(.checkbox-wrapper),
  .product-card:focus-within > :global(.checkbox-wrapper) {
    visibility: visible;
  }
</style>
