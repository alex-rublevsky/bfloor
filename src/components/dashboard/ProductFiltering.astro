---
import { getAllCategories } from "@/db/dashboard/categories";
import { getBrandsWithCollections } from "@/db/dashboard/brands";
import Select from "../shared/Select.astro";

interface Props {
  categoryId: string;
  brandId: string;
  collectionId: string;
}

const { categoryId, brandId, collectionId } = Astro.props;

const categories = await getAllCategories();
const brandsWithCollections = await getBrandsWithCollections();
const selectedBrand = brandsWithCollections.find(
  (brand) => String(brand.id) === brandId,
);
const selectedBrandId = selectedBrand ? brandId : "";
const collectionBelongsToBrand = selectedBrand?.collections.some(
  (collection) => String(collection.id) === collectionId,
);
const selectedCollectionId = collectionBelongsToBrand ? collectionId : "";
---

<div class="filtersBlock">
  <Select
    name="categoryId"
    label="Категория"
    value={categoryId}
    placeholder="Все"
    options={categories.map((category) => ({
      value: String(category.id),
      label: category.name,
    }))}
    aria-describedby="error-categoryId"
  />
  <Select
    name="brandId"
    label="Производитель"
    value={selectedBrandId}
    placeholder="Все"
    options={brandsWithCollections.map((brand) => ({
      value: String(brand.id),
      label: brand.name,
    }))}
  />
  <Select
    name="collectionId"
    label="Коллекция"
    value={selectedCollectionId}
    placeholder={selectedBrandId ? "Все" : "Выберите производителя"}
    options={selectedBrand?.collections.map((collection) => ({
      value: String(collection.id),
      label: collection.name,
    })) ?? []}
    disabled={!selectedBrandId}
  />
</div>

<style>
  .filtersBlock {
    display: flex;
    gap: var(--spacing-3xs);
    padding-inline: var(--section-padding-x);
    padding-block: var(--spacing-sm);

    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 170ms ease,
      translate 170ms ease,
      visibility 170ms;

    @media (width < 768px) {
      padding-top: var(--spacing-md);
    }
  }

  .filtersBlock[data-hidden="true"] {
    opacity: 0;
    translate: 0 -0.4rem;
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>(".filtersBlock")!;
  const categorySelect =
    filters.querySelector<HTMLSelectElement>("#select-categoryId")!;
  const brandSelect =
    filters.querySelector<HTMLSelectElement>("#select-brandId")!;
  const collectionSelect = filters.querySelector<HTMLSelectElement>(
    "#select-collectionId",
  )!;
  categorySelect.addEventListener("change", () =>
    setFilter("categoryId", categorySelect.value),
  );
  brandSelect.addEventListener("change", () =>
    setFilter("brandId", brandSelect.value, ["collectionId"]),
  );
  collectionSelect.addEventListener("change", () =>
    setFilter("collectionId", collectionSelect.value),
  );

  function setFilter(key: string, value: string, clearKeys: string[] = []) {
    const url = new URL(location.href);

    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);

    for (const clearKey of clearKeys) {
      url.searchParams.delete(clearKey);
    }

    window.location.replace(url);
  }
</script>
