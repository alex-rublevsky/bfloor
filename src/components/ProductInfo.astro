---
import Badge from "@/components/shared/Badge.astro";
// import LinkifiedText from "@/components/shared/LinkifiedText.astro";
import { BASE_IMAGE_URL } from "@/constants";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Image } from "astro:assets";
import type { StorefrontProductDetails } from "@/db/storefront/products/types";
import { COUNTRIES } from "@/lib/countries";
import Button from "./shared/Button.astro";

interface Props {
  product: StorefrontProductDetails;
}

const { product } = Astro.props;

const transferLocation = STORE_LOCATIONS.find(
  (location) => !product.storeLocations.includes(location.id),
);

const brand = product.brand;

const country = brand
  ? COUNTRIES.find((country) => country.id === brand.countryId)
  : null;

const variations = product.variations;
---

<div class="infoBlock">
  <h1 class="text-lg! leading-[1.35] pb-2xs">
    {product.name ? product.name : null}
  </h1>
  <!-- TODO: use <output> for showing the total price with quantity: https://youtu.be/HgNDii20FG4?si=XU0n5vSZ9-pEnSjs -->
  <div class="flex gap-2xs">
    {
      product.discountedPrice ? (
        <>
          <p class="line-through" data-pagefind-meta="price">
            {product.price}
          </p>{" "}
          <p data-pagefind-meta="discounted_price">{product.discountedPrice}</p>
        </>
      ) : (
        <h3 data-pagefind-meta="price">{product.price}</h3>
      )
    }
    <span>/{product.unitOfMeasurement}</span>
    <!-- TODO: make this visible only when ADMIN_STOREFRONT_FLAG_KEY is present in local storage -->
    <!-- <Button variant="primary" size="sm" href={editHref}>
      <Icon name="edit" title="Изменить" />
      Изменить
    </Button> -->
  </div>

  {
    variations ? (
      <div class="flex flex-row flex-wrap">
        {variations.map((variation) => (
          <Button size="sm" variant="tertiary">
            {variation.price}
          </Button>
        ))}
      </div>
    ) : null
  }

  <dl>
    {
      product.category ? (
        <div class="description-row">
          <dt>Категория:</dt>
          <dd>
            <a
              href={`/catalog/${product.category.slug}`}
              data-pagefind-filter="Категория">
              {product.category.name}
            </a>
          </dd>
        </div>
      ) : null
    }
    <!-- TODO: fix the link to brand when the respective page is implemented href={`/brand/${brand.slug}`} -->

    {
      brand ? (
        <div class="description-row items-center">
          <dt>Бренд:</dt>
          <a>
            <dd>
              {brand.image ? (
                <>
                  <Image
                    src={BASE_IMAGE_URL + brand.image}
                    width={100}
                    height={100}
                    fit="contain"
                    class="skeleton brand-image"
                    onload="this.closest('.skeleton')?.classList.remove('skeleton')"
                    alt={"Логотип бренда " + brand.name}
                    data-pagefind-ignore
                  />
                  <span class="sr-only" data-pagefind-filter="Производитель">
                    {brand.name}
                  </span>
                </>
              ) : (
                <span class="brand-name" data-pagefind-filter="Производитель">
                  {brand.name}
                </span>
              )}
            </dd>
          </a>
        </div>
      ) : null
    }

    {
      product.collection ? (
        <div class="description-row">
          <dt>Коллекция:</dt>
          <a href={`/brand/${product.collection.slug}`}>
            <dd data-pagefind-filter="Коллекция">{product.collection.name}</dd>
          </a>
        </div>
      ) : null
    }
    {
      product.sku ? (
        <div class="description-row">
          <dt>Артикул:</dt>
          <dd> {product.sku}</dd>
        </div>
      ) : null
    }
    <!-- TODO: fix label not being baseline aligned with the country -->

    {
      country ? (
        <div>
          <div class="description-row">
            <dt class="self-center">Страна производства:</dt>
            <dd>
              <span class="text-sm" data-pagefind-filter="Страна производства">
                {country.name}
              </span>
              <Image
                src={BASE_IMAGE_URL + country?.flagImage}
                width={52.5}
                height={35}
                fit="contain"
                class="skeleton inline ml-2xs pointer-events-none"
                onload="this.closest('.skeleton')?.classList.remove('skeleton')"
                alt={"Флаг " + country.name}
              />
            </dd>
          </div>
        </div>
      ) : null
    }
    <!-- TODO: seems not to be perfectly aligned by the baseline, just like the country -->

    {
      product.storeLocations.length > 0 ? (
        <div class="description-row">
          <dt class="self-center">Доступен на:</dt>
          <div class="flex flex-row gap-3xs items-center">
            <dd class="locationEntries">
              {product.storeLocations.map((storeLocation, index) => (
                <>
                  {index > 0 ? ", " : null}
                  <a
                    href="/contact"
                    data-pagefind-filter={`В наличии:${storeLocation}`}>
                    {
                      STORE_LOCATIONS.find(
                        (location) => location.id === storeLocation,
                      )?.address
                    }
                  </a>
                </>
              ))}
            </dd>
            {product.storeLocations.length === 1 ? (
              <>
                <button id="locationsPopoverTrigger" popovertarget="locations">
                  ?
                </button>
                <div popover id="locations">
                  <p>
                    {"Можем переместить товар на "}
                    <a href="/contact">{transferLocation?.address}</a>
                    {" или "}
                    <a href="/delivery">{" сделать доставку"}</a>
                  </p>
                </div>
              </>
            ) : null}
          </div>
        </div>
      ) : null
    }
  </dl>

  {
    product.attributes.length > 0 ? (
      <>
        <hr />
        <dl class="mt">
          {product.attributes.map((attribute) => (
            <div class="description-row">
              <dt>{attribute.name}:</dt>
              <dd>
                {attribute.values.map((value, index) => (
                  <>
                    {index > 0 ? ", " : null}
                    <span data-pagefind-filter={attribute.name}>
                      {value.name}
                    </span>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </>
    ) : null
  }

  <!-- {
    product.importantNote ? (
      <LinkifiedText
        content={product.importantNote}
        class="product-note text-base"
      />
    ) : null
  } -->
  <!-- <div class="mt-6">
    <LinkifiedText
      content={product.description}
      class="product-description text-base"
    />
  </div> -->
</div>

<style>
  .infoBlock {
    padding-inline: var(--section-padding-x);
    @media (width > 35rem) {
      max-width: 55ch;
      padding-block: var(--spacing-xs);
      padding-inline: var(--spacing-sm);
    }
  }

  dl {
    padding-block: var(--spacing-xs);
    display: grid;
    gap: var(--spacing-3xs);
    & a,
    .brand-name {
      white-space: nowrap;
      font-size: inherit;
    }
    & .brand-name {
      color: inherit;
    }
  }

  & .brand-image {
    translate: var(--spacing-3xs);
    padding: var(--spacing-3xs);
    &:hover {
      background-color: var(--muted);
    }
  }

  & .description-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: var(--spacing-2xs);
    font-size: var(--text-sm);

    & .locationEntries {
      text-align: right;
    }
    & dt {
      white-space: nowrap;
    }
    & dd,
    dt,
    span {
      font-size: inherit;
    }
  }

  #locationsPopoverTrigger {
    margin-left: var(--spacing-3xs);
    background-color: var(--border);
    width: var(--spacing-md);
    height: var(--spacing-md);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--muted);
    color: var(--primary);
    font-weight: 400;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      scale 70ms ease-out,
      background 170ms ease-out,
      border 170ms ease-out;
    &:hover {
      background-color: oklch(from var(--border) calc(l + 0.06) c h);
      border-color: oklch(from var(--muted) calc(l + 0.01) c h);
    }
    &:active {
      transform: scale(0.97);
      background-color: oklch(from var(--border) calc(l - 0.02) c h);
      border-color: oklch(from var(--muted) calc(l - 0.01) c h);
    }
  }

  [popover]#locations {
    padding: var(--spacing-xs);
    position-area: y-end span-x-start;

    & p {
      font-size: var(--text-sm);
      line-height: 130%;
      max-width: 22ch;
    }
  }
</style>
