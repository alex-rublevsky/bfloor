---
import Badge from "@/components/shared/Badge.astro";
import Button from "@/components/shared/Button.astro";
// import LinkifiedText from "@/components/shared/LinkifiedText.astro";
import { ADMIN_STOREFRONT_FLAG_KEY, BASE_IMAGE_URL } from "@/constants";
import { Icon } from "astro-icon/components";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Image } from "astro:assets";
import type { StorefrontProductDetails } from "@/db/storefront/products/types";
import { COUNTRIES } from "@/lib/countries";

interface Props {
  product: StorefrontProductDetails;
}

const { product } = Astro.props;

const editHref = `/dashboard/product/${product.slug}`;
const transferLocation = STORE_LOCATIONS.find(
  (location) => !product.storeLocations.includes(location.id),
);

const brand = product.brand;

const country = brand
  ? COUNTRIES.find((country) => country.id === brand.countryId)
  : null;

const variations = product.variations;
---

<div
  class="px-(--space-2xs) mx-auto lg: min-w-[40ch] lg:max-w-[55ch] lg:pl-0 lg:pr-5 lg:py-5">
  <h1 class="text-lg! leading-[1.35] pb-2xs">
    {
      product.category ? (
        <a
          href={`/?category=${product.category.slug}`}
          class="mr-1.5 inline-block align-baseline">
          <Badge size="large">{product.category.name}</Badge>
        </a>
      ) : null
    }{product.name ? product.name : "no name"}
  </h1>
  <!-- TODO: use <output> for showing the total price with quantity: https://youtu.be/HgNDii20FG4?si=XU0n5vSZ9-pEnSjs -->
  <div class="flex gap-2xs">
    {
      product.discountedPrice ? (
        <>
          <p class="line-through">{product.price}</p>{" "}
          <p>{product.discountedPrice}Р</p>
        </>
      ) : (
        <h3>{product.price}Р</h3>
      )
    }
    <!-- TODO: make this visible only when ADMIN_STOREFRONT_FLAG_KEY is present in local storage -->
    <!-- <Button variant="primary" size="sm" href={editHref}>
      <Icon name="edit" title="Изменить" />
      Изменить
    </Button> -->
  </div>

  {
    variations ? (
      <div class="flex flex-row flex-wrap">
        {variations.map((variation) => (
          <Button size="sm" variant="tertiary">
            {variation.price}
          </Button>
        ))}
      </div>
    ) : undefined
  }

  <dl>
    <!-- TODO: substitute for Image -->
    <!-- <Image
        src={BASE_IMAGE_URL + brand.image}
        width={100}
        height={100}
        fit="contain"
        class="brand-image"
        alt={"Логотип бренда " + brand.name}
      /> -->
    {
      brand ? (
        <div class="description-row items-center">
          <dt>Бренд:</dt>
          <a href={`/brand/${brand.slug}`}>
            <dd>
              {brand.image ? (
                <img
                  src={BASE_IMAGE_URL + brand.image}
                  class="brand-image size-12"
                  alt={"Логотип бренда " + brand.name}
                />
              ) : (
                <span class="brand-name">{brand.name}</span>
              )}
            </dd>
          </a>
        </div>
      ) : null
    }

    {
      product.collection ? (
        <div class="description-row">
          <dt>Коллекция:</dt>
          <a href={`/brand/${product.collection.slug}`}>
            <dd> {product.collection.name}</dd>
          </a>
        </div>
      ) : null
    }
    {
      country ? (
        <div>
          <div class="description-row">
            <dt> Страна производства:</dt>
            <dd>
              <Image
                src={BASE_IMAGE_URL + country?.flagImage}
                width={52.5}
                height={35}
                fit="contain"
                class="inline mr-2xs"
                alt={"Флаг " + country.name}
              />
              {country.name}
            </dd>
          </div>
        </div>
      ) : null
    }
    {
      product.storeLocations.length > 0 ? (
        <div class="description-row">
          <dt>Доступен на:</dt>
          <dd class="flex flex-wrap justify-end ">
            {" "}
            {product.storeLocations.map((storeLocation) => (
              <a href="/contact" data-pagefind-filter="location">
                {
                  STORE_LOCATIONS.find(
                    (location) => location.id === storeLocation,
                  )?.address
                }
              </a>
            ))}
          </dd>
          {product.storeLocations.length === 1 ? (
            <>
              <button id="locationsPopoverTrigger" popovertarget="locations">
                ?
              </button>
              <span popover id="locations">
                можем переместить <br /> товар на{" "}
                <a href="/contact">{transferLocation?.address}</a>
                <br />
                или{" "}
                <a href="/delivery" class="text-accent hover:underline">
                  {" "}
                  сделать доставку
                </a>
              </span>
            </>
          ) : null}
        </div>
      ) : null
    }
  </dl>

  {
    product.attributes.length > 0 ? (
      <>
        <hr />
        <dl class="mt">
          {product.attributes.map((attribute) => (
            <div class="description-row">
              <dt>{attribute.name}:</dt>
              <dd>
                {attribute.values.map((value, index) => (
                  <>
                    {index > 0 ? ", " : null}
                    {value.name}
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </>
    ) : null
  }

  <!-- {
    product.importantNote ? (
      <LinkifiedText
        content={product.importantNote}
        class="product-note text-base"
      />
    ) : null
  } -->
  <!-- <div class="mt-6">
    <LinkifiedText
      content={product.description}
      class="product-description text-base"
    />
  </div> -->
</div>

<style>
  dl {
    /*border: var(--border-width) solid var(--border);*/
    padding-block: var(--spacing-xs);
    display: grid;
    gap: var(--spacing-3xs);
    & a,
    .brand-name {
      white-space: nowrap;
      font-size: inherit;
    }
    & .brand-name {
      color: inherit;
    }
    & a {
      color: var(--accent);
      &:hover {
        text-decoration: underline;
      }
    }
    & dt {
      white-space: nowrap;
    }
    & .brand-image {
      translate: var(--spacing-3xs);
      padding: var(--spacing-3xs);
      &:hover {
        background-color: var(--muted);
      }
    }
  }
  .description-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: var(--spacing-2xs);
    font-size: var(--text-sm);
  }
  #locationsPopoverTrigger {
    margin-left: var(--spacing-3xs);
    background-color: var(--border);
    width: var(--spacing-md);
    height: var(--spacing-md);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--muted);
    color: var(--primary);
    font-weight: 400;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      scale 70ms ease-out,
      background 170ms ease-out,
      border 170ms ease-out;
    &:hover {
      background-color: oklch(from var(--border) calc(l + 0.06) c h);
      border-color: oklch(from var(--muted) calc(l + 0.01) c h);
    }
    &:active {
      transform: scale(0.97);
      background-color: oklch(from var(--border) calc(l - 0.02) c h);
      border-color: oklch(from var(--muted) calc(l - 0.01) c h);
    }
  }

  [popover]#locations {
    padding: var(--spacing-xs);
    position-area: y-end span-x-start;
    line-height: 130%;
  }
</style>
