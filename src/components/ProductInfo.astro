---
import Badge from "@/components/shared/Badge.astro";
// import LinkifiedText from "@/components/shared/LinkifiedText.astro";
import { BASE_IMAGE_URL } from "@/constants";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Image } from "astro:assets";
import type { StorefrontProductDetails } from "@/db/storefront/products/types";
import type { CompactProductVariationForPicker } from "@/db/storefront/products/types";
import { COUNTRIES } from "@/lib/countries";
import { marked } from "marked";
import { Icon } from "astro-icon/components";
import { getUnitOfMeasurement } from "@/lib/units";

interface Props {
  product: StorefrontProductDetails;
}

const { product } = Astro.props;
const unitOfMeasurement =
  getUnitOfMeasurement(product.unitOfMeasurement)?.value ??
  product.unitOfMeasurement;

const transferLocation = STORE_LOCATIONS.find(
  (location) => !product.storeLocations.includes(location.id),
);

const brand = product.brand;

const country = brand
  ? COUNTRIES.find((country) => country.id === brand.countryId)
  : null;

const variations = product.variations;
const defaultVariation = variations[0];
const variationPayload: CompactProductVariationForPicker[] = variations;
const descriptionHTML = product.description
  ? marked.parse(product.description, { async: false })
  : null;
const importantNoteHTML = product.importantNote
  ? marked.parse(product.importantNote, { async: false })
  : null;

const price = Intl.NumberFormat()
  .format(Number(defaultVariation?.price ?? product.price))
  .replaceAll(",", " ");
const discountedValue = defaultVariation
  ? defaultVariation.discountedPrice
  : product.discountedPrice;
const discountedPrice = discountedValue
  ? Intl.NumberFormat().format(Number(discountedValue)).replaceAll(",", " ")
  : undefined;
---

<!-- TODO: add table every 2nd row styling like in /services -->
<div class="infoBlock">
  <h1 class="text-lg! leading-[1.35] pb-2xs">
    {product.name ? product.name : null}
  </h1>
  <!-- TODO: use <output> for showing the total price with quantity: https://youtu.be/HgNDii20FG4?si=XU0n5vSZ9-pEnSjs -->
  <div
    class="productPrices"
    aria-live="polite"
    aria-atomic="true"
    data-variation-prices
    data-variations={JSON.stringify(variationPayload)}>
    {
      discountedPrice ? (
        <>
          <span
            class="price"
            data-current-price
            data-pagefind-meta="discounted_price">
            {discountedPrice}
          </span>

          {unitOfMeasurement ? (
            <span class="currencyAndUnit" data-pagefind-meta="unit">
              р/{unitOfMeasurement}
            </span>
          ) : null}
          <span
            class="discountedPrice"
            data-regular-price
            data-pagefind-meta="price">
            {price}
          </span>
        </>
      ) : (
        <>
          <span class="price" data-current-price data-pagefind-meta="price">
            {price}
          </span>
          {unitOfMeasurement ? (
            <span class="currencyAndUnit" data-pagefind-meta="unit">
              р/{unitOfMeasurement}
            </span>
          ) : null}
          <span class="discountedPrice" data-regular-price hidden />
        </>
      )
    }
    <span class="sr-only" data-pagefind-meta="has_variations">
      {variations.length > 0 ? "true" : "false"}
    </span>
    <!-- TODO: make this visible only when ADMIN_STOREFRONT_FLAG_KEY is present in local storage -->
    <!-- <Button variant="primary" size="sm" href={editHref}>
      <Icon name="edit" title="Изменить" />
      Изменить
    </Button> -->
  </div>

  <style>
    .productPrices {
      .price {
        font-size: var(--text-lg);
      }
      .discountedPrice {
        font-size: var(--text-md);
        font-weight: 300;
      }
      .currencyAndUnit {
        font-size: var(--text-base);
      }
    }
  </style>

  <p
    class="variationPackArea"
    data-variation-pack-area
    hidden={defaultVariation?.squareMetersPerPack == null}>
    Площадь упаковки: {defaultVariation?.squareMetersPerPack ?? ""} м²
  </p>

  {
    product.variationLayers.length > 0 && variations.length > 0 ? (
      <div class="variationPicker" role="group" aria-label="Выбор варианта">
        {product.variationLayers.map((layer, layerIndex) => (
          <fieldset
            class="variationFacet"
            data-variation-facet
            data-attribute-id={layer.attributeId}>
            <legend>{layer.attributeName}</legend>
            <div class="variationOptions">
              {layer.values.map((value) => {
                const selected =
                  defaultVariation?.values[layerIndex] === value.valueId;
                return (
                  <button
                    type="button"
                    class="variationOption"
                    data-variation-option
                    data-value-id={value.valueId}
                    aria-pressed={selected ? "true" : "false"}>
                    {value.valueName}
                  </button>
                );
              })}
            </div>
          </fieldset>
        ))}
      </div>
    ) : null
  }

  <dl>
    {
      product.category ? (
        <div class="description-row">
          <dt>Категория:</dt>
          <dd>
            <a
              href={`/catalog/${product.category.slug}`}
              data-pagefind-filter="Категория">
              {product.category.name}
            </a>
          </dd>
        </div>
      ) : null
    }
    <!-- TODO: fix the link to brand when the respective page is implemented href={`/brand/${brand.slug}`} -->

    {
      brand ? (
        <div class="description-row items-center">
          <dt>Производитель:</dt>
          <a>
            <dd>
              {brand.image ? (
                <>
                  <Image
                    src={BASE_IMAGE_URL + brand.image}
                    width={100}
                    height={100}
                    fit="contain"
                    class="skeleton brand-image"
                    onload="this.closest('.skeleton')?.classList.remove('skeleton')"
                    alt={"Логотип производителя " + brand.name}
                    data-pagefind-ignore
                  />
                  <span class="sr-only" data-pagefind-filter="Производитель">
                    {brand.name}
                  </span>
                </>
              ) : (
                <span class="brand-name" data-pagefind-filter="Производитель">
                  {brand.name}
                </span>
              )}
            </dd>
          </a>
        </div>
      ) : null
    }

    {
      product.collection ? (
        <div class="description-row">
          <dt>Коллекция:</dt>
          <a href={`/brand/${product.collection.slug}`}>
            <dd data-pagefind-filter="Коллекция">{product.collection.name}</dd>
          </a>
        </div>
      ) : null
    }
    {
      product.sku ? (
        <div class="description-row">
          <dt>Артикул:</dt>
          <dd> {product.sku}</dd>
        </div>
      ) : null
    }
    <!-- TODO: fix label not being baseline aligned with the country -->

    {
      country ? (
        <div>
          <div class="description-row">
            <dt class="self-center">Страна производства:</dt>
            <dd class="text-right">
              <span class="text-sm" data-pagefind-filter="Страна производства">
                {country.name}
              </span>
              <Image
                src={BASE_IMAGE_URL + country?.flagImage}
                width={52.5}
                height={35}
                fit="contain"
                class="skeleton inline ml-2xs pointer-events-none w-8 md:w-10"
                onload="this.closest('.skeleton')?.classList.remove('skeleton')"
                alt={"Флаг " + country.name}
              />
            </dd>
          </div>
        </div>
      ) : null
    }
    <!-- TODO: seems not to be perfectly aligned by the baseline, just like the country -->

    {
      product.storeLocations.length > 0 ? (
        <div class="description-row">
          <dt class="self-center">Доступен на:</dt>
          <div class="flex flex-row gap-3xs items-center">
            <dd class="locationEntries">
              {product.storeLocations.map((storeLocation, index) => (
                <>
                  {index > 0 ? ", " : null}
                  <a
                    href="/contact"
                    data-pagefind-filter={`В наличии:${storeLocation}`}>
                    {
                      STORE_LOCATIONS.find(
                        (location) => location.id === storeLocation,
                      )?.address
                    }
                  </a>
                </>
              ))}
            </dd>
            {product.storeLocations.length === 1 ? (
              <>
                <button id="locationsPopoverTrigger" popovertarget="locations">
                  ?
                </button>
                <div popover id="locations">
                  <p>
                    {"Можем переместить товар на "}
                    <a href="/contact">{transferLocation?.address}</a>
                    {" или "}
                    <a href="/delivery">{" сделать доставку"}</a>
                  </p>
                </div>
              </>
            ) : null}
          </div>
        </div>
      ) : null
    }
  </dl>

  {
    product.attributes.length > 0 ? (
      <>
        <hr />
        <dl class="mt">
          {product.attributes.map((attribute) => (
            <div class="description-row">
              <dt>{attribute.name}:</dt>
              <dd>
                {attribute.values.map((value, index) => (
                  <>
                    {index > 0 ? ", " : null}
                    <span data-pagefind-filter={attribute.name}>
                      {value.name}
                    </span>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </>
    ) : null
  }

  {
    importantNoteHTML && (
      <div class="importantNote">
        <Icon class="text-secondary" name="info" title="Важная информация" />
        <div set:html={importantNoteHTML} />
      </div>
    )
  }
  {
    descriptionHTML && (
      <div class="product-description" set:html={descriptionHTML} />
    )
  }
</div>

<style>
  .infoBlock {
    container-type: inline-size;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--section-padding-x);
    /*min-width: 40ch;*/
    padding-block: var(--spacing-2xs);
    @media (width >= 768px) {
      /*min-width: 45ch;*/
      max-width: 55ch;
      padding-block: var(--spacing-xs);
      padding-inline: var(--spacing-sm);
    }
  }

  .variationPicker {
    display: grid;
    gap: var(--spacing-2xs);
    padding-block: var(--spacing-xs);
  }

  .variationFacet {
    border: 0;
    padding: 0;
    min-width: 0;

    legend {
      font-size: var(--text-sm);
      font-weight: 600;
      padding-bottom: var(--spacing-3xs);
    }
  }

  .variationOptions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3xs);
  }

  .variationOption {
    border: var(--border-width) solid var(--muted);
    border-radius: var(--radius-sm);
    padding: var(--spacing-3xs) var(--spacing-2xs);
    cursor: pointer;
    transition:
      opacity 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;

    &[aria-pressed="true"] {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
    }

    &[data-available="false"] {
      opacity: 0.42;
      border-style: dashed;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  }

  .variationPackArea {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  dl {
    padding-block: var(--spacing-xs);
    display: grid;
    gap: var(--spacing-3xs);
    & a,
    .brand-name {
      white-space: nowrap;
      font-size: inherit;
    }
    & .brand-name {
      color: inherit;
    }
  }

  & .brand-image {
    translate: var(--spacing-3xs);
    padding: var(--spacing-3xs);
    &:hover {
      background-color: var(--muted);
    }
  }

  & .description-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: var(--spacing-2xs);

    & .locationEntries {
      text-align: right;
    }
    & dt {
      white-space: nowrap;
    }
    & dd,
    dt,
    span {
      font-size: inherit;
    }
  }

  #locationsPopoverTrigger {
    margin-left: var(--spacing-3xs);
    background-color: var(--border);
    width: var(--spacing-md);
    height: var(--spacing-md);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--muted);
    color: var(--primary);
    font-weight: 400;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      scale 70ms ease-out,
      background 170ms ease-out,
      border 170ms ease-out;
    &:hover {
      background-color: oklch(from var(--border) calc(l + 0.06) c h);
      border-color: oklch(from var(--muted) calc(l + 0.01) c h);
    }
    &:active {
      transform: scale(0.97);
      background-color: oklch(from var(--border) calc(l - 0.02) c h);
      border-color: oklch(from var(--muted) calc(l - 0.01) c h);
    }
  }

  [popover]#locations {
    padding: var(--spacing-xs);
    position-area: y-end span-x-start;

    & p {
      font-size: var(--text-sm);
      line-height: 130%;
      max-width: 22ch;
    }
  }

  .importantNote {
    background-color: color-mix(in oklch, var(--border) 25%, transparent);
    padding: var(--spacing-2xs);
    border: var(--border-width) solid var(--border);
    margin-block: var(--spacing-sm);
    & svg {
      width: 2rem;
      height: auto;
    }

    @container (width > 35ch) {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--spacing-3xs);
    }

    & * {
      font-size: var(--text-sm) !important;
    }
  }
</style>

<script src="@/scripts/productVariations.ts"></script>
