---
import Badge from "@/components/shared/Badge.astro";
import Button from "@/components/shared/Button.astro";
import LinkifiedText from "@/components/shared/LinkifiedText.astro";
import { ADMIN_STOREFRONT_FLAG_KEY, BASE_IMAGE_URL } from "@/constants";
import { Icon } from "astro-icon/components";
import { STORE_LOCATIONS } from "@/lib/storeLocations";
import { Image } from "astro:assets";
import type { StorefrontProduct } from "@/db/storefront/products/types";

interface Props {
  product: StorefrontProduct;
}

const { product } = Astro.props;

const editHref = `/dashboard/product/${product.slug}`;
const transferLocation = STORE_LOCATIONS.find(
  (location) => !product.storeLocations.includes(location.id),
);
---

<div
  class="px-(--space-2xs) mx-auto lg: min-w-[40ch] lg:max-w-[55ch] lg:pl-0 lg:pr-5 lg:py-5">
  <h1 class="text-lg! leading-[1.35] pb-2xs">
    {
      product.category ? (
        <a
          href={`/?category=${product.category.slug}`}
          class="mr-1.5 inline-block align-baseline">
          <Badge size="large">{product.category.name}</Badge>
        </a>
      ) : null
    }{product.name ? product.name : "no name"}
  </h1>

  <div class="flex gap-2xs">
    {
      product.discountedPrice ? (
        <>
          <p class="line-through">{product.price}</p>{" "}
          <p>{product.discountedPrice}Р</p>
        </>
      ) : (
        <h3>{product.price}Р</h3>
      )
    }
    <!-- TODO: make this visible only when ADMIN_STOREFRONT_FLAG_KEY is present in local storage -->
    <Button variant="primary" size="sm" href={editHref}>
      <Icon name="edit" title="Изменить" />
      Изменить
    </Button>
  </div>
  <div class="flex items-center gap-3xs">
    {
      product.brand ? (
        <div class="flex items-center">
          <span>Бренд: </span>
          <a href={`/brand/${product.brand.slug}`}>
            {product.brand.image ? (
              <Image
                src={BASE_IMAGE_URL + product.brand.image}
                width={100}
                height={100}
                fit="contain"
                class="size-full object-contain p-3xs rounded-lg hover:bg-muted"
                alt={"Логотип бренда " + product.brand.name}
              />
            ) : (
              product.brand.name
            )}
          </a>
        </div>
      ) : null
    }
    {
      product.collection ? (
        <div>
          <span>Коллекция: </span>
          <a
            href={`/brand/${product.collection.slug}`}
            class="text-accent hover:underline">
            {product.collection.name}
          </a>
        </div>
      ) : null
    }
  </div>
  {
    product.storeLocations.length > 0 ? (
      <div>
        <span>Доступен на: </span>
        {product.storeLocations.map((storeLocation) => (
          <a href="/contact" class="text-accent hover:underline">
            {
              STORE_LOCATIONS.find((location) => location.id === storeLocation)
                ?.address
            }
          </a>
        ))}
        {product.storeLocations.length === 1 ? (
          <>
            <button id="locationsPopoverTrigger" popovertarget="locations">
              ?
            </button>
            <span popover id="locations">
              можем переместить <br /> товар на{" "}
              <a href="/contact" class="text-accent hover:underline">
                {transferLocation?.address}
              </a>
              <br />
              или{" "}
              <a href="/delivery" class="text-accent hover:underline">
                {" "}
                сделать доставку
              </a>
            </span>
          </>
        ) : null}
      </div>
    ) : null
  }

  {
    product.attributes.length > 0 ? (
      <dl class="mt-sm space-y-xs">
        {product.attributes.map((attribute) => (
          <div class="flex gap-xs">
            <dt class="font-medium">{attribute.name}:</dt>
            <dd>
              {attribute.values.map((value, index) => (
                <>
                  {index > 0 ? ", " : null}
                  {value.name}
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    ) : null
  }

  {
    product.importantNote ? (
      <LinkifiedText
        content={product.importantNote}
        class="product-note text-base"
      />
    ) : null
  }
  <div class="mt-6">
    <LinkifiedText
      content={product.description}
      class="product-description text-base"
    />
  </div>
</div>

<style>
  #locationsPopoverTrigger {
    margin-left: 0.5em;
    background-color: var(--border);
    width: var(--spacing-lg);
    height: var(--spacing-lg);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--muted);
    color: var(--primary);
    font-weight: 500;
    font-size: var(--text-base);
    cursor: pointer;
    transition:
      scale 70ms ease-out,
      background 170ms ease-out,
      border 170ms ease-out;
    &:hover {
      background-color: oklch(from var(--border) calc(l + 0.06) c h);
      border-color: oklch(from var(--muted) calc(l + 0.01) c h);
    }
    &:active {
      transform: scale(0.97);
      background-color: oklch(from var(--border) calc(l - 0.02) c h);
      border-color: oklch(from var(--muted) calc(l - 0.01) c h);
    }
  }

  [popover]#locations {
    padding: var(--spacing-xs);
    position-area: y-end span-x-start;
    line-height: 130%;
  }
</style>
